<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:focusable="true">

    <include layout="@layout/widget_top_bar" />

    <Switch
        android:id="@+id/switch_debug_mode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:text="Mock Mode"
        app:layout_constraintBottom_toTopOf="@+id/sw_factory_usb_off"
        app:layout_constraintRight_toRightOf="parent" />

    <RelativeLayout
        android:id="@+id/view_debug_machine_series"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/margin_layout_10"
        app:layout_constraintEnd_toEndOf="@id/tv_ip_address"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/top_bar">

        <TextView
            android:id="@+id/tv_debug_machine_changed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_marginStart="@dimen/margin_layout_40"
            android:layout_marginTop="@dimen/margin_layout_10"
            android:text="机器类型："
            tools:ignore="HardcodedText" />

        <Spinner
            android:id="@+id/sp_debug_machine_changed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_layout_10"
            android:layout_toEndOf="@id/tv_debug_machine_changed"
            android:entries="@array/machine_series" />

        <Spinner
            android:id="@+id/sp_debug_camera_demo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_layout_10"
            android:layout_marginTop="@dimen/margin_layout_10"
            android:layout_toEndOf="@id/sp_debug_machine_changed"
            android:entries="@array/mock_mode" />

    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/view_debug_machine_model"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/margin_layout_10"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/view_debug_machine_series">

        <TextView
            android:id="@+id/tv_changed_machine_model"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_marginStart="@dimen/margin_layout_40"
            android:layout_marginTop="@dimen/margin_layout_10"
            android:text="机器型号："
            tools:ignore="HardcodedText" />

        <Spinner
            android:id="@+id/sp_changed_machine_model"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_layout_10"
            android:layout_toEndOf="@id/tv_changed_machine_model"
            android:entries="@array/machine_model" />

        <TextView
            android:id="@+id/tv_debug_module_list"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_layout_40"
            android:layout_marginTop="@dimen/margin_layout_10"
            android:layout_toEndOf="@id/sp_changed_machine_model"
            android:text="模组列表"
            tools:ignore="HardcodedText" />

        <Button
            android:id="@+id/bt_debug_module_add"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="38dp"
            android:layout_toEndOf="@id/tv_debug_module_list"
            android:entries="@array/module_toolHead"
            android:text="+" />
    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/view_debug_module_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/margin_layout_10"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/view_debug_machine_model">


    </RelativeLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_module_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/margin_layout_10"
        android:layout_marginEnd="@dimen/margin_layout_10"
        android:visibility="invisible"
        app:layout_constraintBottom_toTopOf="@+id/bt_confirm"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/view_debug_machine_model">

    </androidx.recyclerview.widget.RecyclerView>


    <ScrollView
        android:id="@+id/tv_temp_sv"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/margin_layout_10"
        android:layout_marginEnd="@dimen/margin_layout_10"
        app:layout_constraintBottom_toTopOf="@+id/bt_confirm"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/view_debug_module_list">

        <TextView
            android:id="@+id/tv_temp_show"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </ScrollView>

    <Button
        android:id="@+id/bt_confirm"
        style="@style/AppTheme.Button.BlueButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="40dp"
        android:text="确认mock(/退出程序)"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.499"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/bt_temp"
        style="@style/AppTheme.Button.BlueButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="100dp"
        android:text="执行选择"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.499"
        app:layout_constraintStart_toStartOf="parent" />

    <Switch
        android:id="@+id/sw_factory_usb_off"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/margin_layout_10"
        android:visibility="gone"
        android:text="USB 工厂模式"
        app:layout_constraintBottom_toTopOf="@id/btn_temp_factory"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/btn_temp_factory"
        style="@style/AppTheme.Button.BlueButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/margin_layout_10"
        android:layout_marginBottom="@dimen/margin_layout_10"
        android:visibility="gone"
        android:text="Factory"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <TextView
        android:id="@+id/tv_firm_versions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:alpha="0.5"
        android:textColor="@color/gradient_green_start"
        android:textSize="36sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="屏幕版本：v0.0.1\n主控版本：v0.0.1" />

    <TextView
        android:id="@+id/tv_ip_address"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:textSize="25sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fcv_debug"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
