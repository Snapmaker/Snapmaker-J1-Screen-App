<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/all_dialog_round_background"
    android:orientation="vertical">

    <LinearLayout
        style="@style/DialogContentMarginTheme"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/tip_icon"
            android:layout_width="?attr/theme_icon_functions_large"
            android:layout_height="?attr/theme_icon_functions_large"
            android:layout_marginBottom="?attr/theme_dialog_pic_marginBottom"
            android:src="@drawable/icon_tips_error_80x80"
            android:visibility="gone" />

        <TextView
            android:id="@+id/title_tv"
            style="@style/AppTheme.TextTitleSecondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/margin_layout_4"
            android:gravity="center_horizontal"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tip_tv"
            style="@style/AppTheme.TextBody1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:visibility="gone" />

    </LinearLayout>


</LinearLayout>
