<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/all_dialog_round_background"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <LinearLayout
        style="@style/DialogContentMarginTheme"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/iv_warm_pic"
            android:layout_width="?attr/theme_icon_functions_large"
            android:layout_height="?attr/theme_icon_functions_large"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="@dimen/margin_layout_48"
            android:src="@drawable/icon_tips_error_80x80" />

        <TextView
            android:id="@+id/tv_title"
            style="@style/AppTheme.TextTitleSecondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="?attr/theme_dialog_title_and_content_margin"
            android:gravity="center"
            android:text="sdfsdf"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_warm_tip"
            style="@style/AppTheme.TextExplain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/margin_layout_12"
            android:gravity="center"
            android:text="ssdfsdf" />

        <TextView
            android:id="@+id/tv_content"
            style="@style/AppTheme.TextBody1"
            android:lineSpacingExtra="6dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center" />

    </LinearLayout>

    <View
        android:id="@+id/view_empty"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:visibility="gone" />

    <View
        android:id="@+id/v_normal_line"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/theme_dialog_line_color" />

    <View
        android:id="@+id/v_drop_shadow_line"
        android:layout_width="match_parent"
        style="@style/AppTheme.LineDropShadow"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="?attr/theme_dialog_btn_height"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/cancel_btn"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:gravity="center"
            android:text="button"
            android:textSize="?attr/theme_font_size_body1" />

        <TextView
            android:id="@+id/one_line"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:background="?attr/theme_dialog_line_color" />

        <TextView
            android:id="@+id/second_btn"
            style="@style/AppTheme.TextBody1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:gravity="center"
            android:text="button"
            android:textSize="?attr/theme_font_size_body1" />

        <TextView
            android:id="@+id/second_line"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:background="?attr/theme_dialog_line_color" />

        <TextView
            android:id="@+id/third_btn"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:gravity="center"
            android:text="button"
            android:textSize="?attr/theme_font_size_body1" />

    </LinearLayout>

</LinearLayout>