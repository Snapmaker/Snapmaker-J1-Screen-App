<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <layer-list>
            <item android:width="20dp" android:height="20dp">
                <shape android:shape="rectangle">
                    <corners android:radius="4dp" />
                    <solid android:color="?attr/theme_color_primary" />
                </shape>
            </item>
            <item android:width="12dp" android:height="8dp" android:gravity="center">
                <bitmap android:src="@drawable/ic_j1_tick_small" />
            </item>
        </layer-list>
    </item>

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="4dp" />
            <stroke android:width="1.5dp" android:color="?attr/theme_color_primary" />
            <size android:width="20dp" android:height="20dp" />
        </shape>
    </item>
</selector>
