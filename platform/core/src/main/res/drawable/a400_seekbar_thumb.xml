<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <size android:width="64dp" android:height="64dp" />
            <solid android:color="@color/transparent" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <size android:height="64dp" android:width="64dp" />
            <padding
                android:top="14dp"
                android:bottom="14dp"/>
            <gradient
                android:angle="360"
                android:startColor="?attr/theme_color_normal_button_gradient_start"
                android:endColor="?attr/theme_color_normal_button_gradient_end" />
            <padding android:right="32dp" />
        </shape>
    </item>
</layer-list>
