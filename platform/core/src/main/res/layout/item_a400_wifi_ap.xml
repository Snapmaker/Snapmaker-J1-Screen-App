<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="?attr/theme_list_item_height"
    android:background="?android:attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingEnd="@dimen/margin_48dp"
    tools:ignore="RtlSymmetry"
    tools:layout_height="100dp">

    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/progress"
            android:layout_width="?attr/theme_icon_functions_medium"
            android:layout_height="?attr/theme_icon_functions_medium"
            android:indeterminate="true"
            android:visibility="invisible"
            app:indicatorColor="@color/palette_white_pure"
            app:indicatorInset="8dp"
            app:indicatorSize="52dp"
            app:trackColor="#33FFFFFF"
            app:trackCornerRadius="2dp"
            app:trackThickness="4dp"
            tools:visibility="visible" />

        <ImageView
            android:id="@+id/iv_tick"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:src="@drawable/ic_a400_blue_tick"
            android:visibility="invisible"
            tools:visibility="visible" />
    </FrameLayout>

    <TextView
        android:id="@+id/tv_ssid"
        style="@style/AppTheme.TextBody1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        tools:text="Snapmaker Wi-Fi" />

    <ImageView
        android:id="@+id/iv_ap_encrypt"
        android:layout_width="68dp"
        android:layout_height="68dp"
        tools:src="@drawable/ic_a400_ap_lock" />

    <ImageView
        android:id="@+id/iv_signal"
        android:layout_width="68dp"
        android:layout_height="68dp"
        android:contentDescription="@string/placeholder"
        tools:src="@drawable/ic_a400_signal_good" />

</LinearLayout>
