<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="580dp"
    android:layout_height="178dp"
    android:gravity="center_vertical"
    android:id="@+id/rl_calibration_mode">

    <View
        android:id="@+id/view_calibration_mode"
        android:layout_width="4dp"
        android:layout_height="match_parent"
        android:background="@color/palette_blue_ribbon"/>


    <RelativeLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_toEndOf="@id/view_calibration_mode">

        <TextView
            android:id="@+id/view_calibration_mode_check"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:layout_alignParentTop="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/margin_4dp"
            android:layout_marginTop="@dimen/margin_layout_20"
            android:background="@drawable/icon_check" />

        <TextView
            android:id="@+id/tv_calibration_mode_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_layout_32"
            android:textColor="@color/palette_white_pure"
            android:textSize="@dimen/font_size_28sp"
            android:layout_toEndOf="@+id/view_calibration_mode_check"
            android:text="手动模式"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tv_calibration_mode_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/AppTheme.TextBody2"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="@dimen/margin_layout_56"
            android:layout_below="@id/tv_calibration_mode_title"
            android:layout_toEndOf="@+id/view_calibration_mode_check"
            android:maxLines="2"
            android:ellipsize="end"
            android:visibility="invisible"
            android:text="内容"/>


    </RelativeLayout>

</RelativeLayout>
