<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:focusable="true">

    <include layout="@layout/widget_top_bar_back_only" />

    <TextView
        android:id="@+id/tv_welcome_wifi_password_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="100dp"
        android:fontFamily="@string/font_roboto_condensed"
        android:text="@string/all_wifi"
        android:textAlignment="center"
        android:textColor="@color/default_theme_title"
        android:textSize="@dimen/font_size_h1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_welcome_wifi_password_subtitle"
        style="@style/AppTheme.TextBody2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_layout_5"
        android:text="@string/placeholder"
        android:textAlignment="center"
        android:textColor="@color/palette_white_silver"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_welcome_wifi_password_title" />

    <RelativeLayout
        android:id="@+id/view_welcome_wifi_password"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="175dp"
        android:layout_marginTop="@dimen/margin_layout_40"
        android:layout_marginEnd="175dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_welcome_wifi_password_subtitle">

        <EditText
            android:id="@+id/et_welcome_wifi_password_input"
            style="@style/AppTheme.TextBody2"
            android:layout_width="match_parent"
            android:layout_height="84dp"
            android:background="@drawable/a400_shape_bg_terms_and_conditions_print"
            android:hint="@string/welcome_wifi_enter_password"
            android:inputType="textPassword"
            android:paddingLeft="@dimen/margin_layout_24"
            android:textAlignment="textStart"
            android:textColor="@color/palette_white_pure" />

        <Button
            android:id="@+id/btn_welcome_wifi_password_visibility"
            style="@style/AppTheme.Button"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:layout_alignEnd="@id/et_welcome_wifi_password_input"
            android:layout_marginTop="12.5dp"
            android:layout_marginEnd="@dimen/margin_layout_24"
            android:background="@drawable/ic_settings_password_hide_136x136" />

        <TextView
            android:id="@+id/tv_welcome_wifi_password_tip"
            style="@style/AppTheme.TextExplain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/et_welcome_wifi_password_input"
            android:layout_marginStart="10dp"
            android:layout_marginTop="@dimen/margin_layout_5"
            android:text="@string/placeholder"
            android:textColor="@color/palette_red_monza" />

    </RelativeLayout>

    <Button
        android:id="@+id/btn_welcome_wifi_password_next"
        style="@style/AppTheme.PrimaryButton"
        android:layout_width="292dp"
        android:layout_height="92dp"
        android:layout_marginTop="@dimen/margin_layout_40"
        android:layout_marginBottom="@dimen/margin_layout_40"
        android:background="@drawable/a400_select_shape_welcome_hello_btn"
        android:text="@string/all_connect"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/view_welcome_wifi_password" />

</androidx.constraintlayout.widget.ConstraintLayout>
