<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">


    <ImageView
        android:id="@+id/iv_show_state"
        android:layout_width="35dp"
        android:layout_height="40dp"
        android:padding="@dimen/margin_layout_5"
        android:src="@drawable/ic_j1_home_top_state_left_have"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_show_state_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="@dimen/margin_layout_5"
        android:text="026"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/iv_show_state"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/view_show_state_separator"
        android:layout_width="1px"
        android:layout_height="30dp"
        android:layout_centerHorizontal="true"
        android:background="@color/default_theme_separator"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/tv_show_state_name"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_show_state_temperature"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="@dimen/margin_layout_5"
        android:text="198 ℃"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/view_show_state_separator"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/view_show_state_separator_"
        android:layout_width="1px"
        android:layout_height="30dp"
        android:layout_centerHorizontal="true"
        android:background="@color/default_theme_separator"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/tv_show_state_temperature"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_show_state_target_temp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="@dimen/margin_layout_5"
        android:text="198 ℃"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/view_show_state_separator_"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>