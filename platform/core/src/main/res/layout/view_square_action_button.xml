<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/view_square_action_button"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_centerHorizontal="true">

    <Button
        android:id="@+id/btn_view_square_action_button_background"
        android:layout_width="124dp"
        android:layout_height="124dp"
        android:layout_centerHorizontal="true"
        android:background="@drawable/all_button_square_default" />

    <Button
        android:id="@+id/btn_view_square_action_button_foreground"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_centerHorizontal="true"
        android:background="@color/transparent"
        android:elevation="10dp"
        android:textColor="@color/default_theme_desc1"
        android:textSize="@dimen/font_size_h2" />

    <TextView
        android:id="@+id/tv_view_square_action_button_title"
        style="@style/AppTheme.TextBody2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/btn_view_square_action_button_background"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="12dp"
        android:textAlignment="center"
        android:textAllCaps="false"
        android:textColor="@color/palette_white_pure"
        android:visibility="gone" />

</RelativeLayout>
