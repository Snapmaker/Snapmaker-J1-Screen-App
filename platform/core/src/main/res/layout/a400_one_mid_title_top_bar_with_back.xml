<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <View
        android:id="@+id/top_bar_area"
        android:layout_width="match_parent"
        android:layout_height="132dp" />

    <ImageView
        android:id="@+id/top_bar_back"
        android:layout_width="68dp"
        android:layout_height="68dp"
        android:layout_marginStart="26dp"
        android:contentDescription="@string/placeholder"
        android:src="@drawable/ic_a400_back"
        app:layout_constraintBottom_toBottomOf="@id/top_bar_area"
        app:layout_constraintStart_toStartOf="@id/top_bar_area"
        app:layout_constraintTop_toTopOf="@id/top_bar_area" />

    <TextView
        android:id="@+id/top_bar_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="68dp"
        android:layout_marginEnd="68dp"
        android:gravity="center_horizontal"
        android:textColor="#FFFFFF"
        android:textSize="34sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/top_bar_back"
        app:layout_constraintEnd_toEndOf="@id/top_bar_area"
        app:layout_constraintStart_toStartOf="@id/top_bar_area"
        app:layout_constraintTop_toTopOf="@id/top_bar_back"
        tools:text="1-1 Manual Focus Calibration" />
</merge>
