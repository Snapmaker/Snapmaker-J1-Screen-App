<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/pic_welcome_hello"
    android:clickable="true"
    android:fitsSystemWindows="true"
    android:focusable="true">

    <include layout="@layout/widget_top_bar_back_only" />

    <TextView
        android:id="@+id/tv_welcome_name_title"
        android:layout_width="528dp"
        android:layout_height="36dp"
        android:layout_marginTop="212dp"
        android:fontFamily="@string/font_roboto_condensed"
        android:text="@string/welcome_name_title"
        android:textAlignment="center"
        android:textColor="@color/default_theme_title"
        android:textSize="24sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <RelativeLayout
        android:id="@+id/view_welcome_name_input"
        android:layout_width="416dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_welcome_name_title">

        <EditText
            android:id="@+id/et_welcome_name_input"
            style="@style/AppTheme.EditText.GuideEditText"
            android:layout_width="416dp"
            android:layout_height="84dp"
            android:hint="@string/welcome_name_placeholder"
            android:inputType="text" />

        <TextView
            android:id="@+id/tv_welcome_name_tip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/et_welcome_name_input"
            android:layout_marginStart="@dimen/margin_layout_10"
            android:layout_marginTop="@dimen/margin_layout_5"
            android:layout_marginEnd="@dimen/margin_layout_10"
            android:text="@string/placeholder"
            android:textAlignment="center"
            android:textColor="@color/default_theme_text_warning" />

    </RelativeLayout>

    <Button
        android:id="@+id/btn_welcome_name_next"
        style="@style/AppTheme.Button.BlueButtonLarge"
        android:layout_width="292dp"
        android:layout_height="92dp"
        android:layout_marginBottom="120dp"
        android:text="@string/all_save"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
