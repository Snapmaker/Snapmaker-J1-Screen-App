<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/widget_calibration_control_panel"
    android:layout_width="match_parent"
    android:layout_height="423dp"
    android:background="@drawable/guide_calibration_black_bg">

    <RelativeLayout
        android:id="@+id/rl_control"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <co.ceryle.segmentedbutton.SegmentedButtonGroup
            android:id="@+id/sbg_xyz_control_steps"
            android:layout_width="match_parent"
            android:layout_height="77dp"
            android:paddingLeft="6dp"
            android:paddingTop="6dp"
            android:paddingRight="6dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:sbg_backgroundColor="@color/palette_black_snapmaker"
            app:sbg_borderColor="@color/palette_black_snapmaker"
            app:sbg_borderSize="1px"
            app:sbg_position="0"
            app:sbg_radius="@dimen/margin_layout_16"
            app:sbg_selectorColor="@color/default_theme_primary">

            <co.ceryle.segmentedbutton.SegmentedButton
                android:layout_width="0dp"
                android:layout_height="65dp"
                android:layout_weight="1"
                app:sb_text="@string/all_0_1mm"
                app:sb_textColor="@color/palette_grey_dim"
                app:sb_textColor_onSelection="@color/palette_white_pure"
                app:sb_textSize="24sp" />

            <co.ceryle.segmentedbutton.SegmentedButton
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                app:sb_text="@string/all_1mm"
                app:sb_textColor="@color/palette_grey_dim"
                app:sb_textColor_onSelection="@color/palette_white_pure"
                app:sb_textSize="24sp" />

            <co.ceryle.segmentedbutton.SegmentedButton
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                app:sb_text="@string/all_10mm"
                app:sb_textColor="@color/palette_grey_dim"
                app:sb_textColor_onSelection="@color/palette_white_pure"
                app:sb_textSize="24sp" />

            <co.ceryle.segmentedbutton.SegmentedButton
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                app:sb_text="@string/all_100mm"
                app:sb_textColor="@color/palette_grey_dim"
                app:sb_textColor_onSelection="@color/palette_white_pure"
                app:sb_textSize="24sp" />

        </co.ceryle.segmentedbutton.SegmentedButtonGroup>

        <co.ceryle.segmentedbutton.SegmentedButtonGroup
            android:id="@+id/sbg_b_control_steps"
            android:layout_width="match_parent"
            android:layout_height="77dp"
            android:paddingLeft="6dp"
            android:paddingTop="6dp"
            android:paddingRight="6dp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:sbg_backgroundColor="@color/palette_black_snapmaker"
            app:sbg_borderColor="@color/palette_black_snapmaker"
            app:sbg_borderSize="1px"
            app:sbg_position="0"
            app:sbg_radius="@dimen/margin_layout_16"
            app:sbg_selectorColor="@color/default_theme_primary">

            <co.ceryle.segmentedbutton.SegmentedButton
                android:layout_width="0dp"
                android:layout_height="65dp"
                android:layout_weight="1"
                app:sb_text="@string/all_0_2degree"
                app:sb_textColor="@color/palette_grey_dim"
                app:sb_textColor_onSelection="@color/palette_white_pure"
                app:sb_textSize="24sp" />

            <co.ceryle.segmentedbutton.SegmentedButton
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                app:sb_text="@string/all_1degree"
                app:sb_textColor="@color/palette_grey_dim"
                app:sb_textColor_onSelection="@color/palette_white_pure"
                app:sb_textSize="24sp" />

            <co.ceryle.segmentedbutton.SegmentedButton
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                app:sb_text="@string/all_5degree"
                app:sb_textColor="@color/palette_grey_dim"
                app:sb_textColor_onSelection="@color/palette_white_pure"
                app:sb_textSize="24sp" />

            <co.ceryle.segmentedbutton.SegmentedButton
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                app:sb_text="90°"
                app:sb_textColor="@color/palette_grey_dim"
                app:sb_textColor_onSelection="@color/palette_white_pure"
                app:sb_textSize="24sp" />

        </co.ceryle.segmentedbutton.SegmentedButtonGroup>

    </RelativeLayout>


    <!-- control panel: height expands to fill all height -->
    <RelativeLayout
        android:id="@+id/rl_calibration_control_panel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/guide_cailbration_grey_bg"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/rl_control">

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/vp_calibration_control"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical" />


        <ImageView
            android:id="@+id/iv_calibration_control_first"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_alignParentRight="true"
            android:layout_marginTop="154dp"
            android:layout_marginEnd="@dimen/margin_layout_20"
            android:background="@drawable/ic_view_pager_normal" />

        <ImageView
            android:id="@+id/iv_calibration_control_second"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_below="@+id/iv_calibration_control_first"
            android:layout_alignRight="@+id/iv_calibration_control_first"
            android:layout_marginTop="@dimen/margin_layout_12"
            android:background="@drawable/ic_view_pager_select" />

    </RelativeLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
