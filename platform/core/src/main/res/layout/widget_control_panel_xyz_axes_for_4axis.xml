<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/widget_control_panel_xyz_axes_for_4axis"
    android:layout_width="match_parent"
    android:layout_height="423dp"
    android:background="@drawable/guide_calibration_black_bg">

    <co.ceryle.segmentedbutton.SegmentedButtonGroup
        android:id="@+id/sbg_control_steps"
        android:layout_width="match_parent"
        android:layout_height="77dp"
        android:paddingLeft="6dp"
        android:paddingTop="6dp"
        android:paddingRight="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:sbg_backgroundColor="@color/palette_black_snapmaker"
        app:sbg_borderColor="@color/palette_black_snapmaker"
        app:sbg_borderSize="1px"
        app:sbg_position="0"
        app:sbg_radius="@dimen/margin_layout_16"
        app:sbg_selectorColor="@color/default_theme_primary">

        <co.ceryle.segmentedbutton.SegmentedButton
            android:layout_width="0dp"
            android:layout_height="65dp"
            android:layout_weight="1"
            app:sb_text="@string/all_0_1mm"
            app:sb_textColor="@color/palette_grey_dim"
            app:sb_textColor_onSelection="@color/palette_white_pure"
            app:sb_textSize="24sp" />

        <co.ceryle.segmentedbutton.SegmentedButton
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            app:sb_text="@string/all_1mm"
            app:sb_textColor="@color/palette_grey_dim"
            app:sb_textColor_onSelection="@color/palette_white_pure"
            app:sb_textSize="24sp" />

        <co.ceryle.segmentedbutton.SegmentedButton
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            app:sb_text="@string/all_10mm"
            app:sb_textColor="@color/palette_grey_dim"
            app:sb_textColor_onSelection="@color/palette_white_pure"
            app:sb_textSize="24sp" />

        <co.ceryle.segmentedbutton.SegmentedButton
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            app:sb_text="100 mm"
            app:sb_textColor="@color/palette_grey_dim"
            app:sb_textColor_onSelection="@color/palette_white_pure"
            app:sb_textSize="24sp" />

    </co.ceryle.segmentedbutton.SegmentedButtonGroup>

    <!-- control panel: height expands to fill all height -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/guide_cailbration_grey_bg"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/sbg_control_steps">

        <fabscreen.platform.core.ui.view.CustomSteeringView
            android:id="@+id/sv_control_panel_xy"
            android:layout_width="280dp"
            android:layout_height="280dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_marginLeft="60dp" />

        <Button
            android:id="@+id/btn_control_panel_z_plus"
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:layout_alignTop="@id/sv_control_panel_xy"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="80dp"
            android:background="@drawable/control_btn_up_background" />

        <TextView
            style="@style/AppTheme.TextBody2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_above="@+id/btn_control_panel_z_minus"
            android:layout_below="@+id/btn_control_panel_z_plus"
            android:layout_alignLeft="@+id/btn_control_panel_z_plus"
            android:layout_alignRight="@+id/btn_control_panel_z_plus"
            android:gravity="center"
            android:text="Z"
            android:textColor="@color/palette_white_pure" />

        <Button
            android:id="@+id/btn_control_panel_z_minus"
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:layout_alignBottom="@id/sv_control_panel_xy"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="80dp"
            android:background="@drawable/control_btn_down_background" />

    </RelativeLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
