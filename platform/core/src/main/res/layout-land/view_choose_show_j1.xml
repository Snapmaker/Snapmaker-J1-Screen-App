<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/iv_choose_show_image"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@id/sw_choose_change"
        app:layout_constraintEnd_toStartOf="@+id/tv_choose_content"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_choose_content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="这是内容"
        app:layout_constraintBottom_toTopOf="@id/sw_choose_change"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/iv_choose_show_image"
        app:layout_constraintTop_toTopOf="parent" />

    <Switch
        android:id="@+id/sw_choose_change"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:text="辅助模式"
        app:layout_constraintBottom_toTopOf="@+id/bt_choose_show"
        app:layout_constraintEnd_toEndOf="@+id/bt_choose_show" />


    <Button
        android:id="@+id/bt_choose_show"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_layout_50"
        android:layout_marginEnd="@dimen/margin_layout_50"
        android:layout_marginBottom="60dp"
        android:text="开始"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tv_choose_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:text="这是个标题"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@+id/tv_choose_content"
        app:layout_constraintStart_toStartOf="@+id/tv_choose_content" />


</androidx.constraintlayout.widget.ConstraintLayout>