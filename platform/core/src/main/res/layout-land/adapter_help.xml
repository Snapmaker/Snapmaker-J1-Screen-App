<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/all_dialog_round_background"
    android:orientation="horizontal"
    android:paddingBottom="@dimen/margin_layout_16"
    tools:ignore="MissingDefaultResource">

    <ImageView
        android:id="@+id/iv_help_dialog_pic"
        android:layout_width="240dp"
        android:layout_height="135dp" />

    <TextView
        android:id="@+id/iv_help_dialog_content"
        style="@style/AppTheme.TextBody1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/margin_layout_12"
        android:layout_weight="1" />

</LinearLayout>
