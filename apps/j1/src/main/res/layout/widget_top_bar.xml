<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/top_bar"
    android:layout_width="match_parent"
    android:layout_height="@dimen/height_top_bar">

    <Button
        android:id="@+id/top_bar_back"
        style="@style/AppTheme.Button"
        android:layout_width="@dimen/height_top_bar"
        android:layout_height="@dimen/height_top_bar"
        android:background="@drawable/top_bar_back_background"
        android:contentDescription="@string/todo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/top_bar_title"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:textColor="@color/top_bar_title"
        android:textSize="@dimen/font_size_h2"
        app:layout_constraintEnd_toStartOf="@id/top_bar_info"
        app:layout_constraintStart_toEndOf="@id/top_bar_back"
        tools:text="Title" />

    <ImageButton
        android:id="@+id/top_bar_info"
        style="@style/AppTheme.Button"
        android:layout_width="@dimen/height_top_bar"
        android:layout_height="@dimen/height_top_bar"
        android:layout_gravity="end"
        android:background="@drawable/top_bar_info_background"
        android:contentDescription="@string/placeholder"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_top_bar_info_48x48"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="visible" />

</androidx.constraintlayout.widget.ConstraintLayout>

