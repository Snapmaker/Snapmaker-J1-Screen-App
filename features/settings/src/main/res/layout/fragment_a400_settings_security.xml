<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <include
        layout="@layout/widget_a400_setting_top_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:id="@+id/tap_bar"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:scrollbarSize="8dp"
        android:scrollbarThumbVertical="@drawable/drawable_scrollbar_thumb_vertical"
        android:layout_marginBottom="60dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tap_bar">

        <TextView
            style="@style/AppTheme.TextExplain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_layout_32"
            android:layout_marginLeft="@dimen/margin_layout_48"
            android:layout_marginRight="@dimen/margin_layout_48"
            android:lineSpacingMultiplier="1.2"
            android:text="@string/settings_terms_content"
            android:textColor="?attr/theme_color_body_secondary" />

    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="128dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:gravity="center"
        android:background="@drawable/pic_setting_security_bg">

        <CheckBox
            android:id="@+id/checkBox"
            style="@style/AppTheme.CheckBox"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:layout_alignParentStart="true"
            android:layout_marginStart="18dp"/>

        <TextView
            android:id="@+id/tv_join"
            style="@style/AppTheme.TextBody1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/all_settings_join"
            android:textColor="@color/palette_white_silver" />


        <TextView
            android:id="@+id/tv_experience_program"
            style="@style/AppTheme.TextBody1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:gravity="center_vertical"
            android:autoLink="all"
            android:text="@string/all_settings_user_experience_program"
            android:textColor="@color/palette_blue_ribbon"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
