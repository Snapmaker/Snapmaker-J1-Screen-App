<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="240dp"
    android:layout_height="124dp"
    android:background="@drawable/shape_bg_j1_about_popup"
    android:orientation="vertical">

    <View
        android:id="@+id/v_divider"
        style="@style/AppTheme.SectionDivider"
        android:layout_marginStart="@dimen/margin_layout_16"
        android:layout_marginEnd="@dimen/margin_layout_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/v_top_area"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:background="?android:attr/selectableItemBackground"
        app:layout_constraintBottom_toTopOf="@id/v_divider"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <View
        android:id="@+id/v_bottom_area"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:background="?android:attr/selectableItemBackground"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/v_divider" />

    <TextView
        android:id="@+id/tv_usb"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_16dp"
        android:text="@string/j1_setting_about_usb_flash_drive"
        android:textColor="?attr/theme_color_title_primary"
        android:textSize="?attr/theme_font_size_body1"
        app:layout_constraintBottom_toBottomOf="@id/v_top_area"
        app:layout_constraintStart_toStartOf="@id/v_top_area"
        app:layout_constraintTop_toTopOf="@id/v_top_area" />


    <TextView
        android:id="@+id/tv_lava"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:enabled="false"
        android:text="Snapmaker Luban"
        android:textColor="?attr/theme_color_title_primary"
        android:textSize="?attr/theme_font_size_body1"
        app:layout_constraintBottom_toBottomOf="@id/v_bottom_area"
        app:layout_constraintStart_toStartOf="@id/tv_usb"
        app:layout_constraintTop_toTopOf="@id/v_bottom_area" />

    <ImageView
        android:id="@+id/iv_help"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="@dimen/margin_24dp"
        android:src="@drawable/ic_j1_help"
        app:layout_constraintBottom_toBottomOf="@id/tv_lava"
        app:layout_constraintStart_toEndOf="@id/tv_lava"
        app:layout_constraintTop_toTopOf="@id/tv_lava" />

</androidx.constraintlayout.widget.ConstraintLayout>
