<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#212121"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tv_title"
        style="@style/AppTheme.TextTitlePrimary"
        android:layout_width="match_parent"
        android:layout_height="@dimen/margin_layout_130"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/margin_layout_48"
        android:paddingEnd="@dimen/margin_layout_48"
        android:text="Maintenance"
        android:textStyle="bold" />

    <View
        style="@style/AppTheme.LineDropShadow"
        android:layout_width="match_parent" />

    <include
        android:id="@+id/cl_config_params"
        layout="@layout/item_a400_settings_section"
        android:visibility="gone" />

    <include
        android:id="@+id/cl_module_info"
        layout="@layout/item_a400_settings_section" />

    <include
        android:id="@+id/cl_factory_reset"
        layout="@layout/item_a400_settings_section" />
</LinearLayout>
