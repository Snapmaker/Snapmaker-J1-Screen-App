<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/tv_wifi_title"
        style="@style/AppTheme.TextTitleHeadLine"
        android:layout_width="wrap_content"
        android:layout_height="?attr/theme_list_item_height"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:text="Wi-Fi"
        android:textColor="#F7F8FA"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/switch_wifi"
        style="@style/AppTheme.SwitchButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@id/tv_wifi_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tv_wifi_title"
        tools:checked="true" />

    <!--    <View-->
    <!--        android:id="@+id/v_main_divider"-->
    <!--        android:layout_width="0dp"-->
    <!--        android:layout_height="1dp"-->
    <!--        android:layout_marginTop="19dp"-->
    <!--        android:background="#595A66"-->
    <!--        app:layout_constraintEnd_toEndOf="@id/switch_wifi"-->
    <!--        app:layout_constraintStart_toStartOf="@id/tv_wifi_title"-->
    <!--        app:layout_constraintTop_toBottomOf="@id/tv_wifi_title" />-->

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_ap_list"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_wifi_title"
        tools:listitem="@layout/item_j1_wifi_ap" />
</androidx.constraintlayout.widget.ConstraintLayout>

