<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <include layout="@layout/widget_top_bar" />

    <Button
        android:id="@+id/btn_settings_language_save"
        style="@style/AppTheme.Button"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/height_top_bar"
        android:layout_marginEnd="@dimen/margin_layout_10"
        android:background="@color/transparent"
        android:text="@string/all_save"
        android:textAlignment="viewEnd"
        android:textAllCaps="false"
        android:textSize="@dimen/font_size_h4"
        app:layout_constraintBottom_toBottomOf="@id/top_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/top_bar" />

    <TextView
        android:id="@+id/tv_setting_language_title"
        app:layout_constraintStart_toStartOf="@+id/parent"
        app:layout_constraintTop_toBottomOf="@+id/top_bar"
        android:layout_width="match_parent"
        style="@style/AppTheme.TextTitlePrimary"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/margin_layout_48"
        android:layout_height="@dimen/margin_layout_130"
        android:textStyle="bold"
        android:text="语言"/>

    <ListView
        android:id="@+id/lv_settings_language"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_layout_5"
        android:divider="@drawable/all_list_view_divider"
        android:dividerHeight="@dimen/margin_layout_5"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_setting_language_title" />

</androidx.constraintlayout.widget.ConstraintLayout>