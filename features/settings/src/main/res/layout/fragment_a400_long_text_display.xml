<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/palette_black_snapmaker">

    <Button
        android:id="@+id/btn_user_improvement_program_back"
        android:layout_width="68dp"
        android:layout_height="68dp"
        android:layout_marginStart="26dp"
        android:layout_marginTop="@dimen/margin_layout_32"
        android:background="@drawable/top_bar_back_white"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_title"
        style="@style/AppTheme.TextTitleSecondary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/btn_user_improvement_program_back"
        app:layout_constraintStart_toEndOf="@+id/btn_user_improvement_program_back"
        app:layout_constraintTop_toTopOf="@id/btn_user_improvement_program_back" />

    <TextView
        android:id="@+id/tv_content"
        style="@style/AppTheme.TextExplain"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_layout_48"
        android:layout_marginTop="31dp"
        android:layout_marginEnd="@dimen/margin_layout_48"
        android:text="文案"
        app:layout_constraintTop_toBottomOf="@+id/btn_user_improvement_program_back" />

</androidx.constraintlayout.widget.ConstraintLayout>
