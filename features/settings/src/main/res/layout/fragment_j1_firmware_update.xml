<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/tv_version_title"
        style="@style/AppTheme.TextBody2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_layout_16"
        android:layout_marginTop="@dimen/margin_layout_12"
        android:text="@string/all_update_Firmware_Version"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_version"
        style="@style/AppTheme.TextExplain"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_layout_16"
        android:layout_marginBottom="@dimen/margin_layout_8"
        android:text="V1.4.1"
        android:textColor="@color/palette_grey_storm"
        app:layout_constraintBottom_toTopOf="@id/v_divider"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tv_new_version"
        style="@style/AppTheme.TextTitleSecondary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="@dimen/margin_layout_12"
        android:text="V1.5.0"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_current_version"
        style="@style/AppTheme.TextExplain"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_layout_16"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="@dimen/margin_layout_8"
        android:textColor="@color/palette_grey_storm"
        app:layout_constraintBottom_toTopOf="@id/v_divider"
        app:layout_constraintStart_toStartOf="parent"
        tools:text="Current Version: V1.4.1" />

    <TextView
        android:id="@+id/tv_local_install"
        style="@style/AppTheme.TextBody2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/margin_layout_16"
        android:text="@string/all_local_update"
        android:textColor="?attr/theme_color_primary"
        app:layout_constraintBottom_toTopOf="@id/v_divider"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/v_divider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginStart="@dimen/margin_layout_16"
        android:layout_marginTop="68dp"
        android:layout_marginEnd="@dimen/margin_layout_16"
        android:background="@color/palette_grey_mid"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:id="@+id/sv_change_log"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingVertical="@dimen/margin_12dp"
        app:layout_constraintBottom_toTopOf="@id/v_bottom_bg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/v_divider">

        <LinearLayout
            android:id="@+id/ll_change_log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/margin_layout_16"
            android:paddingEnd="@dimen/margin_layout_16" />
    </ScrollView>

    <TextView
        android:id="@+id/tv_check_fail_title"
        style="@style/AppTheme.TextTitleSecondary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="52dp"
        android:text="@string/j1_setting_update_unable_t_check_for_update"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/v_divider" />

    <TextView
        android:id="@+id/tv_check_fail_desc"
        style="@style/AppTheme.TextBody2"
        android:layout_width="360dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_layout_4"
        android:gravity="center_horizontal"
        android:text="@string/j1_setting_update_unable_t_check_for_update_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_check_fail_title" />

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/pb_checking"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="60dp"
        android:indeterminate="true"
        android:visibility="gone"
        app:indicatorColor="@color/white"
        app:indicatorSize="40dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/v_divider"
        app:trackColor="@color/transparent"
        app:trackThickness="4dp"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/tv_check_progress_desc"
        style="@style/AppTheme.TextBody1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_layout_16"
        android:text="@string/all_checking_for_update"
        app:layout_constraintEnd_toEndOf="@id/pb_checking"
        app:layout_constraintStart_toStartOf="@id/pb_checking"
        app:layout_constraintTop_toBottomOf="@id/pb_checking" />

    <ImageView
        android:id="@+id/iv_already_latest"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:contentDescription="@string/placeholder"
        android:src="@drawable/pic_success_tick"
        app:layout_constraintBottom_toBottomOf="@id/pb_checking"
        app:layout_constraintEnd_toEndOf="@id/pb_checking"
        app:layout_constraintStart_toStartOf="@id/pb_checking"
        app:layout_constraintTop_toTopOf="@id/pb_checking" />

    <TextView
        android:id="@+id/tv_already_latest"
        style="@style/AppTheme.TextBody1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_layout_16"
        android:text="@string/j1_setting_update_already_latest"
        app:layout_constraintEnd_toEndOf="@id/pb_checking"
        app:layout_constraintStart_toStartOf="@id/pb_checking"
        app:layout_constraintTop_toBottomOf="@id/pb_checking" />

    <View
        android:id="@+id/v_bottom_bg"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:background="@drawable/shape_bg_section_detail_normal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <fabscreen.platform.core.ui.view.J1ProgressButton
        android:id="@+id/btn_download_update"
        android:layout_width="140dp"
        android:layout_height="48dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="@id/v_bottom_bg"
        app:layout_constraintEnd_toEndOf="@id/v_bottom_bg"
        app:layout_constraintTop_toTopOf="@id/v_bottom_bg" />

    <TextView
        android:id="@+id/tv_update_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_layout_16"
        android:layout_marginBottom="18dp"
        android:textSize="@dimen/font_size_16sp"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:visibility="visible" />

    <androidx.constraintlayout.widget.Group
        android:id="@+id/group_checking"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="invisible"
        app:constraint_referenced_ids="pb_checking,tv_check_progress_desc" />

    <androidx.constraintlayout.widget.Group
        android:id="@+id/group_check_fail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="invisible"
        app:constraint_referenced_ids="tv_check_fail_title,tv_check_fail_desc" />

    <androidx.constraintlayout.widget.Group
        android:id="@+id/group_latest"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="invisible"
        app:constraint_referenced_ids="iv_already_latest,tv_already_latest" />

    <androidx.constraintlayout.widget.Group
        android:id="@+id/group_new_version_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="invisible"
        app:constraint_referenced_ids="tv_new_version,tv_current_version,sv_change_log,v_bottom_bg,btn_download_update" />

    <androidx.constraintlayout.widget.Group
        android:id="@+id/group_old_version_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="invisible"
        app:constraint_referenced_ids="tv_version_title,tv_version" />
</androidx.constraintlayout.widget.ConstraintLayout>
