    <include
        android:id="@+id/v_top_bar"
        layout="@layout/widget_a400_setting_top_bar" />

    <ScrollView
        android:id="@+id/sv_module_list"
        android:layout_width="532dp"
        android:layout_height="0dp"
        android:layout_marginStart="48dp"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="48dp"
        android:background="@drawable/shape_bg_a400_module_assist_modules"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/v_top_bar">

        <LinearLayout
            android:id="@+id/ll_module_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="38dp"
            android:paddingVertical="48dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="38dp"
                android:text="Current Plugged In Modules"
                android:textColor="#737373"
                android:textSize="24sp" />
        </LinearLayout>
    </ScrollView>

    <View
        android:id="@+id/btn_replace_module"
        android:layout_width="281dp"
        android:layout_height="180dp"
        android:layout_marginStart="21dp"
        android:background="@drawable/selector_bg_a400_module_assist_btn"
        app:layout_constraintStart_toEndOf="@id/sv_module_list"
        app:layout_constraintTop_toTopOf="@id/sv_module_list" />

    <ImageView
        android:id="@+id/iv_replace_module_icon"
        android:layout_width="68dp"
        android:layout_height="68dp"
        android:layout_marginStart="30dp"
        android:src="@drawable/ic_replace_module"
        android:translationZ="2dp"
        app:layout_constraintBottom_toBottomOf="@id/btn_replace_module"
        app:layout_constraintStart_toStartOf="@id/btn_replace_module"
        app:layout_constraintTop_toTopOf="@id/btn_replace_module" />

    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="30dp"
        android:text="Replace Module"
        android:textColor="#C9C9C9"
        android:textSize="24sp"
        app:layout_constraintBottom_toBottomOf="@id/iv_replace_module_icon"
        app:layout_constraintEnd_toEndOf="@id/btn_replace_module"
        app:layout_constraintStart_toEndOf="@id/iv_replace_module_icon"
        app:layout_constraintTop_toTopOf="@+id/iv_replace_module_icon" />

    <View
        android:id="@+id/btn_replace_hotend"
        android:layout_width="281dp"
        android:layout_height="180dp"
        android:layout_marginTop="24dp"
