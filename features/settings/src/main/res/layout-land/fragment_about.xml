<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:focusable="true">

    <RelativeLayout
        android:id="@+id/view_about_machine_chagned"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/margin_layout_10"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tv_about_machine_changed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_marginStart="@dimen/margin_layout_40"
            android:layout_marginTop="@dimen/margin_layout_10"
            android:text="机器型号："
            tools:ignore="HardcodedText" />

        <Spinner
            android:id="@+id/sp_about_machine_changed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_layout_10"
            android:layout_toEndOf="@id/tv_about_machine_changed"
            android:entries="@array/machine_series" />
    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/view_about_toolhead_changed"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/margin_layout_10"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/view_about_machine_chagned">

        <TextView
            android:id="@+id/tv_about_toolhead_changed_head_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_marginStart="@dimen/margin_layout_40"
            android:layout_marginTop="@dimen/margin_layout_10"
            android:text="执行头型号："
            tools:ignore="HardcodedText" />

        <Spinner
            android:id="@+id/sp_about_toolhead_changed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_layout_10"
            android:layout_toEndOf="@id/tv_about_toolhead_changed_head_status"
            android:entries="@array/toolhead_changed" />
    </RelativeLayout>


    <RelativeLayout
        android:id="@+id/view_about_peripherals_change"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_layout_40"
        android:padding="@dimen/margin_layout_10"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/view_about_machine_chagned">

        <TextView
            android:id="@+id/tv_about_rotating"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_marginStart="@dimen/margin_layout_40"
            android:layout_marginTop="@dimen/margin_layout_10"
            android:text="旋转模组："
            tools:ignore="HardcodedText" />

        <Spinner
            android:id="@+id/sp_about_rotating_changed_head_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_layout_10"
            android:layout_toEndOf="@id/tv_about_rotating"
            android:entries="@array/peripheral_module_status" />
    </RelativeLayout>

    <TextView
        android:id="@+id/tv_about_status_data"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_layout_10"
        android:layout_marginEnd="@dimen/margin_layout_10"
        android:layout_marginBottom="@dimen/margin_layout_20"
        android:singleLine="false"
        android:text="@string/placeholder_long"
        android:textColor="@color/default_theme_title"
        android:textSize="@dimen/font_size_h3"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
