<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/palette_grey_nero">

    <include
        android:id="@+id/tap_bar"
        layout="@layout/widget_top_bar_a400_calibration"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <fabscreen.platform.core.ui.view.A400CoordinatesPanel
        android:id="@+id/cp_a400_calibration_coordinates"
        android:layout_width="539dp"
        android:layout_height="423dp"
        app:layout_constraintTop_toTopOf="@+id/cp_a400_calibration_move"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="@dimen/margin_layout_48"/>

    <fabscreen.platform.core.ui.view.XYZControlPanelFourRange
        android:id="@+id/cp_a400_calibration_move"
        android:layout_width="609dp"
        android:layout_height="423dp"
        android:layout_marginTop="@dimen/margin_layout_32"
        android:layout_marginEnd="@dimen/margin_layout_48"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tap_bar" />

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_marginTop="@dimen/margin_layout_40"
        android:background="@color/palette_black_snapmaker"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cp_a400_calibration_move" />

    <Button
        android:id="@+id/bt_a400_calibration_submit"
        style="@style/AppTheme.PrimaryButton"
        android:layout_width="230dp"
        android:layout_height="92dp"
        android:layout_marginEnd="@dimen/margin_layout_48"
        android:layout_marginBottom="@dimen/margin_layout_48"
        android:text="@string/all_save"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>