<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <include
        layout="@layout/widget_top_bar_j1_back_only"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="48dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/fg_bg_round"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/icon_tips_success"
            android:layout_width="132dp"
            android:layout_height="169dp"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:layout_marginStart="@dimen/margin_16dp"
            android:layout_marginTop="@dimen/margin_16dp"
            android:src="@drawable/icon_tips_success" />

        <View
            android:id="@+id/icon_tips_success_line"
            android:layout_width="0.5dp"
            android:layout_height="157dp"
            android:layout_alignTop="@+id/icon_tips_success"
            android:layout_alignBottom="@+id/icon_tips_success"
            android:layout_margin="@dimen/margin_layout_12"
            android:layout_toEndOf="@+id/icon_tips_success"
            android:background="?attr/theme_dialog_line_color" />

        <TextView
            android:id="@+id/tv_tips_success"
            style="@style/AppTheme.TextExplain"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignStart="@+id/icon_tips_success"
            android:layout_alignEnd="@+id/icon_tips_success"
            android:layout_alignBottom="@+id/icon_tips_success"
            android:layout_marginBottom="12dp"
            android:gravity="center"
            android:text="@string/tips_success"
            android:textColor="?attr/theme_color_body_secondary1" />

        <ImageView
            android:id="@+id/icon_tips_x_error"
            android:layout_width="132dp"
            android:layout_height="169dp"
            android:layout_alignParentTop="true"
            android:layout_marginTop="16dp"
            android:layout_toEndOf="@+id/icon_tips_success_line"
            android:src="@drawable/icon_tips_x_error" />

        <TextView
            android:id="@+id/tv_x_error"
            style="@style/AppTheme.TextExplain"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignStart="@+id/icon_tips_x_error"
            android:layout_alignEnd="@+id/icon_tips_x_error"
            android:layout_alignBottom="@+id/icon_tips_x_error"
            android:layout_marginBottom="12dp"
            android:gravity="center"
            android:text="@string/tips_x_error"
            android:textColor="?attr/theme_color_body_secondary1" />


        <ImageView
            android:id="@+id/icon_tips_y_error"
            android:layout_width="132dp"
            android:layout_height="169dp"
            android:layout_alignParentTop="true"
            android:layout_marginStart="@dimen/margin_12dp"
            android:layout_marginTop="16dp"
            android:layout_toEndOf="@+id/icon_tips_x_error"
            android:src="@drawable/icon_tips_y_error" />

        <TextView
            android:id="@+id/tv_y_error"
            style="@style/AppTheme.TextExplain"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignStart="@+id/icon_tips_y_error"
            android:layout_alignEnd="@+id/icon_tips_y_error"
            android:layout_alignBottom="@+id/icon_tips_y_error"
            android:layout_marginBottom="12dp"
            android:gravity="center"
            android:text="@string/tips_y_error"
            android:textColor="?attr/theme_color_body_secondary1" />

        <ImageView
            android:id="@+id/icon_tips_z_error"
            android:layout_width="132dp"
            android:layout_height="169dp"
            android:layout_alignParentTop="true"
            android:layout_marginStart="@dimen/margin_12dp"
            android:layout_marginTop="16dp"
            android:layout_toEndOf="@+id/icon_tips_y_error"
            android:src="@drawable/icon_tips_z_error" />

        <TextView
            android:id="@+id/tv_z_error"
            style="@style/AppTheme.TextExplain"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignStart="@+id/icon_tips_z_error"
            android:layout_alignEnd="@+id/icon_tips_z_error"
            android:layout_alignBottom="@+id/icon_tips_z_error"
            android:layout_marginBottom="12dp"
            android:gravity="center"
            android:text="@string/tips_z_error"
            android:textColor="?attr/theme_color_body_secondary1" />

        <TextView
            style="@style/AppTheme.TextBody2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/icon_tips_y_error"
            android:layout_alignParentStart="true"
            android:layout_alignParentEnd="true"
            android:layout_marginStart="@dimen/margin_layout_16"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="@dimen/margin_layout_16"
            android:text="If the check model is not printed as expected, you can do the calibration again."
            android:textColor="?attr/theme_color_body_secondary1" />


        <TextView
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_alignParentBottom="true"
            android:background="@drawable/shape_bg_section_detail_normal" />

        <Button
            android:id="@+id/btn_next"
            style="@style/AppTheme.PrimaryButton"
            android:layout_width="140dp"
            android:layout_height="48dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="6dp"
            android:text="@string/all_complete" />


    </RelativeLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
