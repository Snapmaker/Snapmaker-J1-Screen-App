<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/default_theme_background">

    <include
        layout="@layout/widget_top_bar_j1_back_only"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/iv_calibration_high_temperature_warning_normal"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:layout_marginStart="8dp"
            android:background="@drawable/icon_high_temperature_warning_normal_64x64" />

        <ImageView
            android:id="@+id/iv_calibration_glass_plate_normal"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentTop="true"
            android:layout_toStartOf="@+id/iv_calibration_high_temperature_warning_normal"
            android:background="@drawable/icon_glass_plate_normal_64x64" />

    </RelativeLayout>


    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="48dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/fg_bg_round"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/iv_show_gif"
            android:layout_width="188dp"
            android:layout_height="204dp"
            android:layout_alignParentLeft="true"
            android:layout_alignParentTop="true"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="16dp"
            android:elevation="250dp" />


        <TextView
            android:id="@+id/tv_calibration_title"
            style="@style/AppTheme.TextTitleSecondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_marginStart="16dp"
            android:layout_marginTop="24dp"
            android:layout_toEndOf="@+id/iv_show_gif"
            android:gravity="center_vertical"
            android:text="Calibrate Left Point"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_calibration_progress"
            style="@style/AppTheme.TextBody2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="27dp"
            android:layout_marginEnd="21dp"
            android:textColor="?attr/theme_color_body_explain"
            android:visibility="invisible" />

        <TextView
            android:id="@+id/tv_calibration_content_1"
            style="@style/AppTheme.TextBody2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/tv_calibration_title"
            android:layout_alignParentEnd="true"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="16dp"
            android:layout_toEndOf="@+id/iv_show_gif"
            android:gravity="center_vertical"
            android:lineSpacingExtra="6dp"
            android:text="@string/leveling_bed_calibration_auxiliary_left_point_content"
            android:textAppearance="@style/remove_the_" />

        <RelativeLayout
            android:id="@+id/rl_calibration_remove_glass"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/tv_calibration_content_1"
            android:layout_alignParentEnd="true"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="16dp"
            android:layout_toEndOf="@+id/iv_show_gif"
            android:gravity="center_vertical"
            android:visibility="gone">

            <ImageView
                android:id="@+id/iv_calibration_remove_glass"
                android:layout_width="@dimen/margin_layout_16"
                android:layout_height="@dimen/margin_layout_16"
                android:layout_alignParentStart="true"
                android:layout_alignParentTop="true"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="@dimen/margin_layout_8"
                android:gravity="center"
                android:src="@drawable/ic_icon_tips_warning_32x32" />

            <TextView
                android:id="@+id/tv_calibration_remove_glass"
                style="@style/AppTheme.TextBody2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_toEndOf="@+id/iv_calibration_remove_glass"
                android:gravity="center_vertical"
                android:lineSpacingExtra="6dp"
                android:textAppearance="@style/remove_the_"
                android:textColor="?attr/theme_color_accent_warning" />
        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/rl_calibration_heating_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/tv_calibration_content_1"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"
            android:layout_toEndOf="@+id/iv_show_gif"
            android:gravity="center_vertical"
            android:visibility="gone">

            <ImageView
                android:id="@+id/iv_nozzle_state_left"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_alignParentStart="true"
                android:layout_alignParentTop="true"
                android:src="@drawable/icon_nozzle_left_normal_64x64" />

            <TextView
                android:id="@+id/tv_nozzle_state_left"
                style="@style/AppTheme.TextBody2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_toEndOf="@+id/iv_nozzle_state_left"
                android:gravity="center_vertical"
                android:lineSpacingExtra="10sp"
                android:text="@string/extruder_temperature"
                android:textAppearance="@style/remove_the_" />

            <ImageView
                android:id="@+id/iv_nozzle_state_right"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_alignParentTop="true"
                android:layout_marginStart="4dp"
                android:layout_toEndOf="@+id/tv_nozzle_state_left"
                android:src="@drawable/icon_nozzle_right_normal_64x64" />

            <TextView
                android:id="@+id/tv_nozzle_state_right"
                style="@style/AppTheme.TextBody2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_toEndOf="@+id/iv_nozzle_state_right"
                android:gravity="center_vertical"
                android:lineSpacingExtra="10sp"
                android:text="@string/extruder_temperature"
                android:textAppearance="@style/remove_the_" />

            <ImageView
                android:id="@+id/iv_bed_state"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_alignParentTop="true"
                android:layout_marginStart="4dp"
                android:layout_toEndOf="@+id/tv_nozzle_state_right"
                android:src="@drawable/ic_heated_bed_normal_64x64" />

            <TextView
                android:id="@+id/tv_bed_state"
                style="@style/AppTheme.TextBody2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_toEndOf="@+id/iv_bed_state"
                android:gravity="center_vertical"
                android:lineSpacingExtra="10sp"
                android:text="@string/extruder_temperature"
                android:textAppearance="@style/remove_the_" />
        </RelativeLayout>


        <TextView
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_alignParentBottom="true"
            android:background="@drawable/shape_bg_section_detail_normal" />

        <Button
            android:id="@+id/btn_second"
            style="@style/AppTheme.SecondaryButton"
            android:layout_width="140dp"
            android:layout_height="48dp"
            android:layout_alignParentBottom="true"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="6dp"
            android:layout_toStartOf="@id/btn_next"
            android:text="临时跳过"
            android:textSize="18dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btn_next"
            style="@style/AppTheme.PrimaryButton"
            android:layout_width="140dp"
            android:layout_height="48dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="6dp"
            android:text="@string/all_next" />
    </RelativeLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
