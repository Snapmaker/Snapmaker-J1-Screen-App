<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <include
        layout="@layout/widget_top_bar_j1_back_only"
        android:visibility="invisible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="48dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/fg_bg_round"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/rectangle_2"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="55dp"
            android:elevation="250dp"
            android:src="@drawable/pic_like_160x160" />

        <TextView
            android:id="@+id/tv_fragment_calibration_success_title"
            style="@style/AppTheme.TextTitleSecondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/rectangle_2"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="@string/j1_calibration_calibrated_successfully"
            android:textStyle="bold" />

        <!--        <TextView-->
        <!--            android:id="@+id/tv_fragment_calibration_success_content"-->
        <!--            style="@style/AppTheme.TextBody2"-->
        <!--            android:layout_width="488dp"-->
        <!--            android:layout_height="wrap_content"-->
        <!--            android:layout_below="@+id/tv_fragment_calibration_success_title"-->
        <!--            android:layout_centerHorizontal="true"-->
        <!--            android:layout_marginTop="8dp"-->
        <!--            android:gravity="center"-->
        <!--            android:text="@string/calibration_success_content"-->
        <!--            android:textColor="?attr/theme_color_body_secondary1" />-->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_alignParentBottom="true"
            android:background="@drawable/shape_bg_section_detail_normal" />

        <Button
            android:id="@+id/btn_next"
            style="@style/AppTheme.PrimaryButton"
            android:layout_width="140dp"
            android:layout_height="48dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="6dp"
            android:text="@string/all_complete" />


    </RelativeLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
