<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/theme_color_page_background">

    <include
        layout="@layout/widget_top_bar_a400_calibration"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/all_dialog_round_background"
        android:padding="68dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/top_bar">

        <ImageView
            android:id="@+id/iv_leveling_z_ico"
            android:layout_width="112dp"
            android:layout_height="112dp"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"
            android:src="@drawable/pic_leveling_z_left" />

        <TextView
            android:id="@+id/tv_leveling_z_content"
            style="@style/AppTheme.TextBody1"
            android:layout_width="444dp"
            android:layout_height="wrap_content"
            android:layout_below="@id/iv_leveling_z_ico"
            android:layout_marginTop="@dimen/margin_layout_32"
            android:gravity="center"
            android:text="@string/a400_leveling_z_calibration_l" />

    </RelativeLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
