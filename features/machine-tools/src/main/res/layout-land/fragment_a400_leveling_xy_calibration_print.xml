    <LinearLayout
        android:id="@+id/li_print_detail"
        android:layout_width="wrap_content"
        android:layout_height="310dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="120dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/v_model_container"
        app:layout_constraintTop_toBottomOf="@+id/top_bar"
        tools:minWidth="500dp" />

    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="68dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/iv_print_base_show">

        <ImageView
            android:id="@+id/btn_a400_print_setting"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:background="@drawable/img_setting_round_black"
            android:src="@drawable/icon_setting_68x68" />

        <ImageView
            android:id="@+id/btn_a400_print_stop"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_marginLeft="@dimen/margin_layout_32"
            android:layout_toRightOf="@+id/btn_a400_print_setting"
