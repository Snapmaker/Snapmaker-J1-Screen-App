<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:focusable="true"
    tools:ignore="MissingDefaultResource">

    <include
        layout="@layout/widget_top_bar_a400_calibration"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/iv_cnc_origin_assistant_set_carving_tool_pc"
        android:layout_width="0dp"
        android:layout_height="359dp"
        android:layout_marginStart="@dimen/margin_layout_48"
        android:layout_marginTop="@dimen/margin_layout_32"
        android:layout_marginEnd="@dimen/margin_layout_48"
        android:background="@drawable/pic_guide_normal"
        app:layout_constraintEnd_toStartOf="@+id/cl_cnc_origin_assistant_set_carving_tool"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/top_bar" />

    <TextView
        android:id="@+id/tv_cnc_origin_assistant_set_carving_tool_desc"
        style="@style/AppTheme.TextBody2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_layout_48"
        android:layout_marginTop="@dimen/margin_layout_32"
        android:layout_marginEnd="@dimen/margin_layout_48"
        android:text="@string/cnc_origin_assistant_set_carving_tool_desc"
        android:textAlignment="textStart"
        android:textColor="@color/palette_grey_dim"
        app:layout_constraintEnd_toStartOf="@+id/cl_cnc_origin_assistant_set_carving_tool"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/iv_cnc_origin_assistant_set_carving_tool_pc" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_cnc_origin_assistant_set_carving_tool"
        android:layout_width="705dp"
        android:layout_height="0dp"
        android:background="@color/palette_grey_nero"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/top_bar">

        <GridView
            android:id="@+id/gv_origin_assistant_bits"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginStart="62dp"
            android:layout_marginEnd="62dp"
            android:gravity="center"
            android:horizontalSpacing="10dp"
            android:listSelector="@color/transparent"
            android:numColumns="3"
            android:stretchMode="columnWidth"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            style="@style/AppTheme.LineDropShadow"
            android:layout_width="match_parent"
            android:layout_marginBottom="36dp"
            app:layout_constraintBottom_toTopOf="@+id/btn_cnc_origin_assistant_set_carving_tool_next" />

        <Button
            android:id="@+id/btn_cnc_origin_assistant_set_carving_tool_next"
            style="@style/AppTheme.Button.BlueButton"
            android:layout_width="230dp"
            android:layout_height="92dp"
            android:layout_marginEnd="@dimen/margin_layout_48"
            android:layout_marginBottom="@dimen/margin_layout_48"
            android:text="@string/all_next"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>


</androidx.constraintlayout.widget.ConstraintLayout>

