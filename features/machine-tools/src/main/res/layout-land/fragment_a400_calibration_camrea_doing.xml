<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <include
        layout="@layout/widget_top_bar_a400_calibration"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/iv_a400_calibration_camera_doing"
        android:layout_width="578dp"
        android:layout_height="434dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/top_bar"
        android:src="@drawable/pic_guide_normal"/>

    <TextView
        android:id="@+id/tv_a400_calibration_camera_doing"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/AppTheme.TextBody1"
        android:textColor="@color/palette_white_pure"
        android:text="@string/calibartion_a400_camera_doing"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/iv_a400_calibration_camera_doing"
        app:layout_constraintStart_toStartOf="@+id/iv_a400_calibration_camera_doing"
        app:layout_constraintTop_toBottomOf="@+id/iv_a400_calibration_camera_doing" />


</androidx.constraintlayout.widget.ConstraintLayout>