<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <include
        layout="@layout/widget_top_bar_a400_calibration"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <RelativeLayout
        android:id="@+id/rl_calibration"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="?attr/theme_color_page_background"
        android:paddingLeft="@dimen/margin_layout_48"
        android:paddingRight="@dimen/margin_layout_48"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/iv_a400_leveling_z_calibration_move"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/top_bar">

        <ImageView
            android:id="@+id/fragment_calibration_image"
            android:layout_width="479dp"
            android:layout_height="359dp"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="23dp"
            android:src="@drawable/pic_guide_normal" />

        <TextView
            android:id="@+id/fragment_calibration_title"
            style="@style/AppTheme.TextBody1"
            android:textColor="@color/palette_white_pure"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/fragment_calibration_image"
            android:layout_marginTop="24dp"
            android:text="@string/manual_tool_title" />

        <TextView
            android:id="@+id/fragment_calibration_content"
            style="@style/AppTheme.TextExplain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/fragment_calibration_title"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="12dp"
            android:text="@string/manual_tool_message" />

    </RelativeLayout>


    <RelativeLayout
        android:id="@+id/iv_a400_leveling_z_calibration_move"
        android:layout_width="705dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/top_bar"
        android:background="@color/palette_grey_nero">

<!--        A400DirectionControlPanel-->
        <fabscreen.platform.core.ui.view.XYZControlPanelFourRange
            android:id="@+id/cp_a400_calibration_move"
            android:layout_width="match_parent"
            android:layout_height="423dp"
            android:layout_marginStart="@dimen/margin_layout_48"
            android:layout_marginTop="@dimen/margin_layout_32"
            android:layout_marginEnd="@dimen/margin_layout_48" />

        <fabscreen.platform.core.ui.view.A400DirectionControlPanel
            android:id="@+id/cp_a400_calibration_move_z"
            android:layout_width="match_parent"
            android:layout_marginStart="@dimen/margin_layout_48"
            android:layout_marginEnd="@dimen/margin_layout_48"
            android:layout_marginTop="@dimen/margin_layout_32"
            android:layout_height="423dp"
            android:visibility="gone"/>

        <View
            android:layout_width="match_parent"
            style="@style/AppTheme.LineDropShadow"
            android:layout_above="@+id/bt_a400_calibration_submit"
            android:layout_marginBottom="36dp" />

        <Button
            android:id="@+id/bt_a400_calibration_submit"
            style="@style/AppTheme.PrimaryButton"
            android:layout_width="230dp"
            android:layout_height="92dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:layout_marginEnd="@dimen/margin_layout_48"
            android:layout_marginBottom="@dimen/margin_layout_48"
            android:text="@string/all_save" />
    </RelativeLayout>

</androidx.constraintlayout.widget.ConstraintLayout>