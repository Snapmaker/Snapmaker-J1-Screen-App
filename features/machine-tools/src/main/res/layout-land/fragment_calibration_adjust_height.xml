<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <include
        layout="@layout/widget_top_bar_j1_back_only"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="48dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/fg_bg_round"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/iv_leveling_bed_auxiliary_calibration"
            android:layout_width="188dp"
            android:layout_height="204dp"
            android:layout_alignParentLeft="true"
            android:layout_alignParentTop="true"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="16dp"
            android:elevation="250dp" />

        <TextView
            android:id="@+id/tv_next_bg"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_alignParentTop="true"
            android:layout_alignParentBottom="true"
            android:layout_marginTop="250dp"
            android:background="@drawable/shape_bg_section_detail_normal" />

        <fabscreen.platform.core.ui.view.XYZControlPanel
            android:id="@+id/xyz_panel_touch_platform"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_above="@+id/tv_next_bg"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            android:layout_toEndOf="@+id/iv_leveling_bed_auxiliary_calibration" />

        <Button
            android:id="@+id/btn_next"
            style="@style/AppTheme.Button.BlueButton"
            android:layout_width="180dp"
            android:layout_height="70dp"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:layout_marginStart="501dp"
            android:layout_marginTop="258dp"
            android:text="Next"
            android:textSize="18dp" />


    </RelativeLayout>


</androidx.constraintlayout.widget.ConstraintLayout>
