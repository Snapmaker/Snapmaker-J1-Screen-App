<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:focusable="true">

    <include
        layout="@layout/widget_top_bar_a400_calibration"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/iv_prepare_install_material"
        android:layout_width="578dp"
        android:layout_height="434dp"
        android:layout_marginStart="@dimen/margin_layout_48"
        android:layout_marginTop="@dimen/margin_layout_64"
        android:src="@drawable/pic_rotary_laser_install_material_360x240"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/top_bar" />

    <RelativeLayout
        android:id="@+id/view_laser_prepare_install_material_content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_layout_48"
        android:layout_marginEnd="@dimen/margin_layout_48"
        app:layout_constraintBottom_toBottomOf="@+id/iv_prepare_install_material"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/iv_prepare_install_material"
        app:layout_constraintTop_toTopOf="@+id/iv_prepare_install_material">

        <TextView
            android:id="@+id/tv_laser_prepare_install_material_content"
            style="@style/AppTheme.TextBody2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/a400_cnc_origin_fix_material_content"
            android:textColor="@color/palette_grey_dim" />

        <TextView
            android:id="@+id/tv_laser_prepare_install_material_tailstock_warning"
            style="@style/AppTheme.TextBody2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/tv_laser_prepare_install_material_content"
            android:layout_marginTop="20dp"
            android:text="@string/a400_cnc_origin_fix_material_waring"
            android:textColor="@color/palette_orange_web"
            android:visibility="gone" />

    </RelativeLayout>

    <Button
        android:id="@+id/btn_preview_laser_install_material_next"
        style="@style/AppTheme.PrimaryButton"
        android:layout_width="230dp"
        android:layout_height="92dp"
        android:layout_marginEnd="@dimen/margin_layout_48"
        android:layout_marginBottom="@dimen/margin_layout_48"
        android:text="@string/all_next"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
