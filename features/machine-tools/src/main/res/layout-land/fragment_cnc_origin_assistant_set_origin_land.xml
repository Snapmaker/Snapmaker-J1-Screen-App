<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:focusable="true">

    <include
        layout="@layout/widget_top_bar_a400_calibration"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <ImageView
        android:id="@+id/iv_cnc_origin_assistant_set_origin_instructions"
        android:layout_width="0dp"
        android:layout_height="359dp"
        android:layout_marginStart="@dimen/margin_layout_48"
        android:layout_marginTop="@dimen/margin_layout_32"
        android:layout_marginEnd="@dimen/margin_layout_48"
        android:contentDescription="@string/placeholder"
        android:scaleType="centerCrop"
        app:layout_constraintEnd_toStartOf="@+id/cl_origin_assistant_control"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/top_bar" />

    <TextView
        android:id="@+id/tv_cnc_origin_assistant_set_origin_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_layout_48"
        android:layout_marginTop="@dimen/margin_layout_32"
        android:layout_marginEnd="@dimen/margin_layout_48"
        android:textColor="@color/palette_white_pure"
        android:textSize="28sp"
        app:layout_constraintEnd_toStartOf="@+id/cl_origin_assistant_control"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_cnc_origin_assistant_set_origin_instructions" />

    <TextView
        android:id="@+id/tv_cnc_origin_assistant_set_origin_content"
        style="@style/AppTheme.TextExplain"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_layout_48"
        android:layout_marginTop="@dimen/margin_layout_4"
        android:layout_marginEnd="@dimen/margin_layout_48"
        android:textColor="@color/palette_grey_dim"
        app:layout_constraintEnd_toStartOf="@+id/cl_origin_assistant_control"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_cnc_origin_assistant_set_origin_title" />


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_origin_assistant_control"
        android:layout_width="705dp"
        android:layout_height="0dp"
        android:background="@color/palette_grey_nero"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/top_bar">

        <fabscreen.platform.core.ui.view.NoScrollViewPager
            android:id="@+id/vp_cnc_origin_assistant_control_panels"
            android:layout_width="0dp"
            android:layout_height="423dp"
            android:layout_marginStart="@dimen/margin_layout_48"
            android:layout_marginTop="@dimen/margin_layout_32"
            android:layout_marginEnd="@dimen/margin_layout_48"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <include layout="@layout/widget_control_panel_xyz_axes_for_4axis" />

            <include layout="@layout/widget_control_panel_b_axis" />

        </fabscreen.platform.core.ui.view.NoScrollViewPager>

        <View
            android:id="@+id/v_cnc_origin_assistant_set_origin_line"
            style="@style/AppTheme.LineDropShadow"
            android:layout_width="match_parent"
            android:layout_marginBottom="36dp"
            app:layout_constraintBottom_toTopOf="@+id/view_cnc_origin_assistant_set_origin_buttons" />

        <!-- buttons -->
        <FrameLayout
            android:id="@+id/view_cnc_origin_assistant_set_origin_buttons"
            android:layout_width="230dp"
            android:layout_height="90dp"
            android:layout_marginEnd="@dimen/margin_layout_48"
            android:layout_marginBottom="@dimen/margin_layout_48"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <Button
                android:id="@+id/btn_widget_set_origin_x1"
                style="@style/AppTheme.PrimaryButton"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="@string/cnc_origin_assistant_set_x1"
                android:visibility="gone" />

            <Button
                android:id="@+id/btn_widget_set_origin_x2"
                style="@style/AppTheme.PrimaryButton"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="@string/cnc_origin_assistant_set_x2"
                android:visibility="gone" />

            <Button
                android:id="@+id/btn_widget_set_origin_y"
                style="@style/AppTheme.PrimaryButton"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="@string/cnc_origin_assistant_set_y"
                android:visibility="gone" />

            <Button
                android:id="@+id/btn_widget_set_origin_z"
                style="@style/AppTheme.PrimaryButton"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="@string/cnc_origin_assistant_set_z"
                android:visibility="gone" />

            <Button
                android:id="@+id/btn_widget_set_origin_b"
                style="@style/AppTheme.PrimaryButton"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="@string/cnc_origin_assistant_set_b" />

        </FrameLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>


</androidx.constraintlayout.widget.ConstraintLayout>
