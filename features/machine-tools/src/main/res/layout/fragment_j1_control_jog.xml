<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/theme_color_page_background">

    <LinearLayout
        android:layout_width="360dp"
        android:layout_height="52dp"
        android:layout_marginEnd="11dp"
        android:background="@drawable/shape_bg_section_detail_normal"
        android:weightSum="3"
        app:layout_constraintEnd_toStartOf="@+id/rl_btn_home"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"

        >

        <TextView
            android:id="@+id/tv_0_1"
            style="@style/AppTheme.TextBody1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/all_0_1mm" />

        <TextView
            android:id="@+id/tv_1_0"
            style="@style/AppTheme.TextBody1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/all_1mm" />

        <TextView
            android:id="@+id/tv_10"
            style="@style/AppTheme.TextBody1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/all_10mm" />

    </LinearLayout>


    <RelativeLayout
        android:id="@+id/rl_btn_home"
        android:layout_width="@dimen/height_dialog_pic_112"
        android:layout_height="@dimen/margin_layout_52"
        android:background="@drawable/shape_bg_section_detail_normal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btn_home"
            android:layout_width="@dimen/margin_layout_32"
            android:layout_height="@dimen/margin_layout_32"
            android:layout_centerInParent="true"
            android:src="@drawable/icon_j1_setting_home" />

    </RelativeLayout>

    <RelativeLayout
        android:layout_width="484dp"
        android:layout_height="232dp"
        android:background="@drawable/shape_bg_section_detail_normal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:id="@+id/lin_j1_motor_control_switch"
            android:layout_width="52dp"
            android:layout_height="200dp"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="42dp"
            android:layout_marginTop="@dimen/margin_layout_16"
            android:layout_marginBottom="@dimen/margin_layout_16"
            android:background="@drawable/pic_tab_horizontal_top_440x104"
            android:gravity="center_vertical"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <TextView
                android:id="@+id/tv_j1_control_l"
                style="@style/AppTheme.TextTitlePrimary"
                android:layout_width="@dimen/margin_layout_52"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="L" />

            <TextView
                android:id="@+id/tv_j1_control_r"
                style="@style/AppTheme.TextTitlePrimary"
                android:layout_width="@dimen/margin_layout_52"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="R" />

        </LinearLayout>

        <fabscreen.platform.core.ui.view.CustomSteeringView
            android:id="@+id/csv_control_panel_xy"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:layout_centerInParent="true" />


        <Button
            android:id="@+id/btn_control_panel_z_plus"
            android:layout_width="@dimen/size_button_80"
            android:layout_height="@dimen/size_button_80"
            android:layout_alignParentTop="true"
            android:layout_marginStart="36dp"
            android:layout_marginTop="20dp"
            android:layout_toEndOf="@+id/csv_control_panel_xy"
            android:background="@drawable/control_j1_btn_up_background" />

        <TextView
            style="@style/AppTheme.TextBody3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_above="@+id/btn_control_panel_z_minus"
            android:layout_below="@+id/btn_control_panel_z_plus"
            android:layout_marginStart="45sp"
            android:layout_toEndOf="@+id/csv_control_panel_xy"
            android:gravity="center"
            android:text="Z Offset" />

        <Button
            android:id="@+id/btn_control_panel_z_minus"
            android:layout_width="@dimen/size_button_80"
            android:layout_height="@dimen/size_button_80"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="36dp"
            android:layout_marginBottom="20dp"
            android:layout_toEndOf="@+id/csv_control_panel_xy"

            android:background="@drawable/control_j1_btn_down_background" />


    </RelativeLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
