<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <include layout="@layout/widget_top_bar_j1_back_only" />

    <View
        android:id="@+id/v_big_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/fg_bg_round"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/top_bar" />

    <View
        android:id="@+id/v_bottom_container"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:background="@drawable/shape_bg_section_detail_normal"
        app:layout_constraintBottom_toBottomOf="@id/v_big_container"
        app:layout_constraintEnd_toEndOf="@id/v_big_container"
        app:layout_constraintStart_toStartOf="@id/v_big_container" />

    <Button
        android:id="@+id/btn_next"
        style="@style/AppTheme.PrimaryButton"
        android:layout_width="140dp"
        android:layout_height="48dp"
        android:layout_marginEnd="12dp"
        android:enabled="false"
        android:text="@string/all_next"
        app:layout_constraintBottom_toBottomOf="@id/v_bottom_container"
        app:layout_constraintEnd_toEndOf="@id/v_bottom_container"
        app:layout_constraintTop_toTopOf="@id/v_bottom_container" />

    <ImageView
        android:id="@+id/iv_model_pic"
        android:layout_width="268dp"
        android:layout_height="180dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="28dp"
        android:layout_marginEnd="80dp"
        android:src="@drawable/pic_j1_calibration_vibration_model"
        app:layout_constraintEnd_toEndOf="@id/v_big_container"
        app:layout_constraintTop_toTopOf="@id/v_big_container" />

    <TextView
        android:id="@+id/tv_choose_best_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="24dp"
        android:text="@string/j1_calibration_vibration_choose_best_area_title"
        android:textColor="#F7F8FA"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@id/iv_model_pic"
        app:layout_constraintStart_toStartOf="@id/v_big_container"
        app:layout_constraintTop_toTopOf="@id/v_big_container" />

    <TextView
        android:id="@+id/tv_choose_best_area_content"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="24dp"
        android:lineSpacingExtra="6dp"
        android:text="@string/j1_calibration_vibration_choose_best_area_content"
        android:textColor="#C4C5CC"
        android:textSize="16sp"
        app:layout_constraintBottom_toTopOf="@id/v_bottom_container"
        app:layout_constraintEnd_toEndOf="@id/tv_choose_best_title"
        app:layout_constraintStart_toStartOf="@id/tv_choose_best_title"
        app:layout_constraintTop_toBottomOf="@id/tv_choose_best_title" />

    <RadioGroup
        android:id="@+id/rg_areas"
        android:layout_width="161dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="27dp"
        android:layout_marginEnd="60dp"
        app:layout_constraintEnd_toEndOf="@id/v_big_container"
        app:layout_constraintTop_toTopOf="@id/v_big_container">

        <RadioButton
            android:layout_width="match_parent"
            android:layout_height="34.5dp"
            android:background="@drawable/selector_vibration_choose_area"
            android:button="@null"
            tools:checked="true" />

        <RadioButton
            android:layout_width="match_parent"
            android:layout_height="34.5dp"
            android:layout_marginTop="1dp"
            android:background="@drawable/selector_vibration_choose_area"
            android:button="@null"
            tools:checked="true" />

        <RadioButton
            android:layout_width="match_parent"
            android:layout_height="34.5dp"
            android:layout_marginTop="1dp"
            android:background="@drawable/selector_vibration_choose_area"
            android:button="@null"
            tools:checked="true" />

        <RadioButton
            android:layout_width="match_parent"
            android:layout_height="34.5dp"
            android:layout_marginTop="1dp"
            android:background="@drawable/selector_vibration_choose_area"
            android:button="@null"
            tools:checked="true" />
    </RadioGroup>
</androidx.constraintlayout.widget.ConstraintLayout>