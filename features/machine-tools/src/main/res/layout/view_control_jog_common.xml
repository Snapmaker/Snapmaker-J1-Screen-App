<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="@dimen/margin_layout_5"
    android:background="@color/default_theme_primary">

    <!-- 1. xyz / 2. b(optional)  -->
    <androidx.viewpager.widget.ViewPager
        android:id="@+id/vp_jog_mods"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!--  bottom dot indicator for ViewPager  -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tl_jog_indicator"
        style="@style/AppTheme.DefaultPageIndicator"
        android:layout_gravity="center_horizontal|bottom"
        android:visibility="invisible" />
</FrameLayout>
