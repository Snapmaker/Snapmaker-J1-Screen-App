<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/shape_bg_section_detail_normal">

    <RelativeLayout
        android:id="@+id/rl_heated_bed"
        android:layout_width="236dp"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <RelativeLayout
            android:id="@+id/rl_control_heated_bed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true">

            <TextView
                android:id="@+id/tv_heated_bed_title"
                style="@style/AppTheme.TextExplain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:text="@string/print_heated_bed_temp"
                android:textColor="?attr/theme_color_title_primary" />

            <LinearLayout
                android:id="@+id/ll_heated_bed_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/tv_heated_bed_title"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_zone_0_cur_temp"
                    style="@style/AppTheme.TextTitlePrimary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textStyle="bold"
                    tools:text="100" />


                <TextView
                    style="@style/AppTheme.TextTitlePrimary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="\/"
                    android:textStyle="bold" />


                <TextView
                    android:id="@+id/tv_zone_0_target_temp"
                    style="@style/AppTheme.TextTitlePrimary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textStyle="bold"
                    tools:text="100" />

                <TextView
                    style="@style/AppTheme.TextTitlePrimary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:text="@string/all_unit_temperature"
                    android:textSize="?attr/theme_font_size_title2" />

            </LinearLayout>

        </RelativeLayout>

        <fabscreen.platform.core.ui.view.CustomArcSeekBar
            android:id="@+id/cas_heated_bed_temp"
            style="@style/AppTheme.CustomSeekBarTheme"
            android:layout_width="167dp"
            android:layout_height="167dp"
            android:layout_below="@+id/rl_control_heated_bed"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="16dp"
            android:padding="20dp"
            app:max="110" />

        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignTop="@+id/cas_heated_bed_temp"
            android:layout_alignBottom="@+id/cas_heated_bed_temp"
            android:layout_centerHorizontal="true"
            android:gravity="center">

            <Button
                android:id="@+id/btn_heated_bed_heat"
                android:layout_width="@dimen/size_button_80"
                android:layout_height="@dimen/size_button_80"
                android:background="@drawable/pic_progress_bg"
                android:text="On"
                android:textAllCaps="false" />

        </RelativeLayout>

    </RelativeLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
