<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include layout="@layout/widget_top_bar" />

    <androidx.viewpager.widget.ViewPager
        android:id="@+id/vp_control"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/margin_layout_5"
        android:layout_marginBottom="@dimen/margin_layout_5"
        android:layout_weight="1" />

    <fabscreen.platform.core.ui.view.bottombar.BottomBar
        android:id="@+id/bb_control"
        android:layout_width="match_parent"
        android:layout_height="@dimen/height_bottom_bar" />

</LinearLayout>
