<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/theme_color_page_background">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="434dp"
        android:layout_marginStart="@dimen/margin_layout_48"
        android:layout_marginTop="@dimen/margin_layout_64"
        android:layout_marginEnd="@dimen/margin_layout_48"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="578dp"
            android:layout_height="434dp"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:layout_alignParentBottom="true"
            android:src="@drawable/pic_cnc_normal" />


        <TextView
            android:id="@+id/temp_auto_thickness_measure"
            android:layout_width="578dp"
            android:layout_height="434dp"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:layout_alignParentBottom="true"
            android:text="材料厚度为："
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_auto_thickness_measure_title"
            style="@style/AppTheme.TextBody1"
            android:layout_width="558dp"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_marginTop="30dp"
            android:text="@string/print_automatic_thickness_measurement"
            android:textColor="@color/palette_white_pure" />

        <TextView
            android:id="@+id/tv_auto_thickness_measure_details"
            style="@style/AppTheme.TextExplain"
            android:layout_width="558dp"
            android:layout_height="wrap_content"
            android:layout_below="@+id/tv_auto_thickness_measure_title"
            android:layout_alignParentRight="true"
            android:layout_marginTop="@dimen/margin_layout_12" />


    </RelativeLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
