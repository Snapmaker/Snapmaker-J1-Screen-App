<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/shape_bg_section_detail_normal">

    <!--  Lighting  -->

    <RelativeLayout
        android:id="@+id/rl_print_adjustment_lighting"
        android:layout_width="236dp"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <RelativeLayout
            android:id="@+id/rl_print_adjustment_lighting_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true">

            <TextView
                android:id="@+id/tv_print_adjustment_lighting_title"
                style="@style/AppTheme.TextExplain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:text="@string/j1_print_adjust_lighting"
                android:textColor="?attr/theme_color_title_primary" />

            <LinearLayout
                android:id="@+id/ll_print_adjustment_lighting_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/tv_print_adjustment_lighting_title"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="@dimen/margin_layout_4"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_lighting_value_current"
                    style="@style/AppTheme.TextTitlePrimary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textStyle="bold"
                    tools:text="100" />

                <TextView
                    style="@style/AppTheme.TextTitlePrimary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:text="@string/all_unit_percentage"
                    android:textSize="?attr/theme_font_size_title2" />

            </LinearLayout>

        </RelativeLayout>

        <fabscreen.platform.core.ui.view.CustomArcSeekBar
            android:id="@+id/cas_j1_print_adjustment_lighting"
            style="@style/AppTheme.CustomSeekBarTheme"
            android:layout_width="167dp"
            android:layout_height="167dp"
            android:layout_below="@+id/rl_print_adjustment_lighting_content"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="@dimen/margin_layout_16"
            android:padding="20dp"
            app:max="100" />
    </RelativeLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
