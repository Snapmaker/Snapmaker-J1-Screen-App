    <!--  J1-->
    <string name="j1_how_to_load_filament_step_1">步骤一：取下顶板。</string>
    <string name="j1_how_to_load_filament_step_2">步骤二：将耗材挂在料架上，然后将耗材插入进料口，直至其从另一端伸出。</string>
    <string name="j1_how_to_load_filament_step_3">步骤三：将滑钮向后推并按住，然后将耗材插入打印头，直至感觉到阻力（以左打印头为例）。</string>
    <string name="j1_how_to_load_filament_step_4">步骤四：设置目标温度，然后点击<b>加热</b>。</string>
    <string name="j1_how_to_load_filament_step_5">步骤五：点击<b>进料</b>（必要时，打印头会先行移动至便于进料的位置）。</string>
    <string name="j1_how_to_load_filament_step_6">步骤六：当耗材从喷嘴中流出后，点击<b>停止进料</b>。</string>
    <string name="j1_how_to_load_filament_step_7">步骤七：将导料管插入打印头，再卡入导料管夹。最后，重新固定顶板。</string>

