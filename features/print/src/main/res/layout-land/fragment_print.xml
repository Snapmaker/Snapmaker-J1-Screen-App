<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/demo_print_bg"
    android:clickable="true"
    android:focusable="true">

    <include layout="@layout/widget_top_bar" />

    <RelativeLayout
        android:id="@+id/view_print_model"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_layout_20"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/top_bar">

        <ImageView
            android:id="@+id/iv_print_base_show"
            android:layout_width="wrap_content"
            android:layout_height="80dp"
            android:layout_marginTop="200dp"
            android:scaleType="fitCenter"
            android:src="@drawable/demo_print_platform" />

        <ImageView
            android:id="@+id/iv_print_file_diagram"
            android:layout_width="250dp"
            android:layout_height="250dp"
            android:layout_centerHorizontal="true"
            android:scaleType="fitCenter"
            android:src="@drawable/demo_print_model1" />
    </RelativeLayout>

    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="100dp"
        android:layout_marginStart="@dimen/margin_layout_40"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/top_bar">

        <Button
            android:id="@+id/btn_left_temperature"
            style="@style/AppTheme.Button.DefaultButton"
            android:layout_width="@dimen/size_button_64"
            android:layout_height="@dimen/height_button_64"
            android:layout_alignParentStart="true" />

        <TextView
            android:id="@+id/tv_print_left_temperature"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignBaseline="@id/btn_left_temperature"
            android:layout_toEndOf="@id/btn_left_temperature"
            android:layout_marginStart="@dimen/margin_layout_10"
            android:text="左 - 挤出头温度"
            android:textColor="@color/custom_grey_200"
            android:textSize="@dimen/font_size_h4" />

        <Button
            android:id="@+id/btn_bed_temperature"
            style="@style/AppTheme.Button.DefaultButton"
            android:layout_width="@dimen/size_button_64"
            android:layout_height="@dimen/height_button_64"
            android:layout_below="@id/btn_left_temperature"
            android:layout_alignParentStart="true"
            android:layout_marginTop="@dimen/margin_layout_40" />

        <TextView
            android:id="@+id/tv_print_bed_temperature"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignBaseline="@id/btn_bed_temperature"
            android:layout_toEndOf="@id/btn_bed_temperature"
            android:layout_marginStart="@dimen/margin_layout_10"
            android:text="热床温度"
            android:textColor="@color/custom_grey_200"
            android:textSize="@dimen/font_size_h4" />

    </RelativeLayout>

    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="100dp"
        android:layout_marginEnd="@dimen/margin_layout_40"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/top_bar">

        <Button
            android:id="@+id/btn_right_temperature"
            style="@style/AppTheme.Button.DefaultButton"
            android:layout_width="@dimen/size_button_64"
            android:layout_height="@dimen/height_button_64"
            android:layout_alignParentEnd="true" />

        <TextView
            android:id="@+id/tv_print_right_temperature"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignBaseline="@id/btn_right_temperature"
            android:layout_marginEnd="@dimen/margin_layout_10"
            android:layout_toStartOf="@id/btn_right_temperature"
            android:text="右 - 挤出头温度"
            android:textColor="@color/custom_grey_200"
            android:textSize="@dimen/font_size_h4" />

        <Button
            android:id="@+id/btn_print_progress"
            style="@style/AppTheme.Button.DefaultButton"
            android:layout_width="@dimen/size_button_64"
            android:layout_height="@dimen/height_button_64"
            android:layout_below="@id/btn_right_temperature"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="@dimen/margin_layout_40" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignBaseline="@id/btn_print_progress"
            android:layout_marginEnd="@dimen/margin_layout_10"
            android:layout_toStartOf="@id/btn_print_progress"
            android:text="打印进度"
            android:textColor="@color/custom_grey_200"
            android:textSize="@dimen/font_size_h4" />

    </RelativeLayout>

    <Button
        android:id="@+id/btn_print_control_stop"
        style="@style/AppTheme.Button.BlueButton"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/height_button_45"
        android:layout_marginTop="@dimen/margin_layout_40"
        android:text="Stop"
        app:layout_constraintTop_toBottomOf="@id/top_bar"
        app:layout_constraintEnd_toEndOf="@id/view_print_model"/>

    <Button
        android:id="@+id/btn_print_control_pause"
        style="@style/AppTheme.Button.BlueButton"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/height_button_45"
        android:layout_marginTop="@dimen/margin_layout_40"
        android:text="pause"
        app:layout_constraintTop_toBottomOf="@id/top_bar"
        app:layout_constraintStart_toEndOf="@id/btn_print_control_stop"/>

    <Button
        android:id="@+id/btn_print_control_resume"
        style="@style/AppTheme.Button.BlueButton"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/height_button_45"
        android:layout_marginTop="@dimen/margin_layout_40"
        android:visibility="gone"
        android:text="resume"
        app:layout_constraintTop_toBottomOf="@id/top_bar"
        app:layout_constraintStart_toEndOf="@id/btn_print_control_stop"/>

    <RelativeLayout
        android:id="@+id/view_print_file_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_layout_20"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/view_print_model" >

        <TextView
            android:id="@+id/tv_print_file_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:text="Rabbit.gcode"
            android:textColor="@color/custom_grey_200"
            android:textSize="@dimen/font_size_h4" />

        <TextView
            android:id="@+id/tv_print_remaining_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tv_print_file_name"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="@dimen/margin_layout_10"
            android:text="剩余时间：20 d 13h 20m"
            android:textColor="@color/custom_grey_200"
            android:textSize="@dimen/font_size_h4" />

        <TextView
            android:id="@+id/tv_print_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="200dp"
            android:layout_toEndOf="@id/tv_print_remaining_time"
            android:layout_alignBaseline="@id/tv_print_remaining_time"
            android:text=""
            android:textColor="@color/custom_grey_200"
            android:textSize="@dimen/font_size_h4" />
    </RelativeLayout>

    <!--  Hardcode Control Bar  -->
    <RelativeLayout
        android:id="@+id/view_bottom_control_bar"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:background="@drawable/demo_print_bottom_control_bar"
        android:layout_marginTop="@dimen/margin_layout_20"
        android:layout_marginStart="@dimen/margin_layout_40"
        android:layout_marginEnd="@dimen/margin_layout_40"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/view_print_file_desc">

        <ImageView
            android:id="@+id/iv_print_bottom_control_enclosure"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_centerVertical="true"
            android:layout_marginStart="100dp"
            android:scaleType="fitCenter"
            android:src="@drawable/demo_print_control_enclosure" />

        <ImageView
            android:id="@+id/iv_print_bottom_control_fan1"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="120dp"
            android:layout_toEndOf="@id/iv_print_bottom_control_enclosure"
            android:scaleType="fitCenter"
            android:layout_centerVertical="true"
            android:src="@drawable/demo_print_control_fan" />

        <ImageView
            android:id="@+id/iv_print_bottom_control_speed"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="120dp"
            android:layout_toEndOf="@id/iv_print_bottom_control_fan1"
            android:scaleType="fitCenter"
            android:layout_centerVertical="true"
            android:src="@drawable/demo_print_control_speed" />

        <ImageView
            android:id="@+id/iv_print_bottom_control_fan2"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="120dp"
            android:layout_toEndOf="@id/iv_print_bottom_control_speed"
            android:scaleType="fitCenter"
            android:layout_centerVertical="true"
            android:src="@drawable/demo_print_control_fan" />

        <ImageView
            android:id="@+id/iv_print_bottom_control_air_purifier"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="120dp"
            android:layout_toEndOf="@id/iv_print_bottom_control_fan2"
            android:scaleType="fitCenter"
            android:layout_centerVertical="true"
            android:src="@drawable/demo_print_control_air_purifier" />

    </RelativeLayout>

    <Button
        android:id="@+id/btn_print_trigger_filament"
        style="@style/AppTheme.Button.DefaultButton"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/height_button_45"
        android:layout_marginTop="@dimen/margin_layout_20"
        android:layout_marginStart="@dimen/margin_layout_40"
        android:text="Filament"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_print_control_pause" />

</androidx.constraintlayout.widget.ConstraintLayout>
