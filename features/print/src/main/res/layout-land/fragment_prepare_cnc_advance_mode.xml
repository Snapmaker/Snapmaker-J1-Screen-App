<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:clickable="true"
    android:focusable="true">

    <include layout="@layout/widget_top_bar" />

    <RelativeLayout
        android:id="@+id/view_prepare_cnc_advance_mode_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_layout_20"
        android:layout_marginTop="@dimen/margin_layout_40"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/top_bar">

        <ImageView
            android:id="@+id/iv_prepare_cnc_advance_mode_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:scaleType="fitCenter"
            android:src="@drawable/demo_prepare_advance_pic" />

        <TextView
            android:id="@+id/tv_prepare_cnc_advance_mode_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/iv_prepare_cnc_advance_mode_desc"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="@dimen/margin_layout_10"
            android:text="移动工作头到需设为 XY 原点的位置"
            android:textColor="@color/default_theme_title"
            android:textSize="@dimen/font_size_h3"
            android:textStyle="bold" />

    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/view_prepare_cnc_advance_mode_control"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/margin_layout_60"
        android:layout_marginEnd="@dimen/margin_layout_10"
        android:layout_marginTop="@dimen/margin_layout_20"
        android:layout_marginBottom="@dimen/margin_layout_20"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/view_prepare_cnc_advance_mode_desc"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/top_bar"
        app:layout_constraintBottom_toTopOf="@id/view_prepare_cnc_advance_mode_buttons">

<!--        <include layout="@layout/widget_control_panel_xyz_axes"/>-->

    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/view_prepare_cnc_advance_mode_buttons"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_layout_40"
        android:layout_marginEnd="@dimen/margin_layout_40"
        android:layout_marginBottom="@dimen/margin_layout_20"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <Button
            android:id="@+id/btn_prepare_cnc_advance_mode_select_mode"
            style="@style/AppTheme.Button.DefaultButton"
            android:layout_width="300dp"
            android:layout_height="@dimen/height_button_64"
            android:layout_alignParentStart="true"
            android:layout_marginStart="@dimen/margin_layout_20"
            android:text="高级模式 | 设置"
            android:textSize="@dimen/font_size_h3" />

        <Button
            android:id="@+id/btn_prepare_cnc_advance_mode_next"
            style="@style/AppTheme.Button.BlueButton"
            android:layout_width="300dp"
            android:layout_height="@dimen/height_button_64"
            android:layout_alignParentEnd="true"
            android:layout_marginStart="@dimen/margin_layout_40"
            android:layout_marginEnd="@dimen/margin_layout_20"
            android:text="下一步"
            android:textSize="@dimen/font_size_h3" />

    </RelativeLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
