<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:clickable="true"
    android:focusable="true">

    <RelativeLayout
        android:id="@+id/view_prepare_laser_xy_origin_select_mode"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="120dp"
        android:layout_marginEnd="120dp"
        android:layout_marginTop="120dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" >

        <Button
            android:id="@+id/btn_prepare_laser_xy_origin_select_mode_basic"
            style="@style/AppTheme.Button.BlueButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/height_button_64"
            android:layout_marginStart="80dp"
            android:layout_marginEnd="80dp"
            android:text="基础模式"
            android:textSize="@dimen/font_size_h3" />

        <Button
            android:id="@+id/btn_prepare_laser_xy_origin_select_mode_advance"
            style="@style/AppTheme.Button.BlueButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/height_button_64"
            android:layout_below="@id/btn_prepare_laser_xy_origin_select_mode_basic"
            android:layout_marginTop="80dp"
            android:layout_marginStart="80dp"
            android:layout_marginEnd="80dp"
            android:text="高级模式"
            android:textSize="@dimen/font_size_h3" />
    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/view_prepare_laser_xy_origin_buttons"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_layout_40"
        android:layout_marginEnd="@dimen/margin_layout_40"
        android:layout_marginBottom="@dimen/margin_layout_20"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <Button
            android:id="@+id/btn_prepare_laser_xy_origin_select_mode_cancel"
            style="@style/AppTheme.Button.DefaultButton"
            android:layout_width="300dp"
            android:layout_height="@dimen/height_button_64"
            android:layout_alignParentStart="true"
            android:layout_marginStart="@dimen/margin_layout_20"
            android:text="取消"
            android:textSize="@dimen/font_size_h3" />

        <Button
            android:id="@+id/btn_prepare_laser_xy_origin_select_mode_confirm"
            style="@style/AppTheme.Button.BlueButton"
            android:layout_width="300dp"
            android:layout_height="@dimen/height_button_64"
            android:layout_alignParentEnd="true"
            android:layout_marginStart="@dimen/margin_layout_40"
            android:layout_marginEnd="@dimen/margin_layout_20"
            android:text="确定"
            android:textSize="@dimen/font_size_h3" />

    </RelativeLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
