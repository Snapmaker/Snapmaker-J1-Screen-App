<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:clickable="true"
    android:focusable="true">

    <RelativeLayout
        android:id="@+id/view_prepare_laser_work_height_select_mode"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="120dp"
        android:layout_marginEnd="120dp"
        android:layout_marginTop="120dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" >

        <Button
            android:id="@+id/btn_prepare_laser_work_height_select_mode_auto_measure"
            style="@style/AppTheme.Button.BlueButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/height_button_64"
            android:layout_marginStart="80dp"
            android:layout_marginEnd="80dp"
            android:text="自动测量"
            android:textSize="@dimen/font_size_h3" />

        <Button
            android:id="@+id/btn_prepare_laser_work_height_select_mode_input_material"
            style="@style/AppTheme.Button.BlueButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/height_button_64"
            android:layout_below="@id/btn_prepare_laser_work_height_select_mode_auto_measure"
            android:layout_marginTop="@dimen/margin_layout_20"
            android:layout_marginStart="80dp"
            android:layout_marginEnd="80dp"
            android:text="输入材料厚度"
            android:textSize="@dimen/font_size_h3" />

        <Button
            android:id="@+id/btn_prepare_laser_work_height_select_mode_touch_material"
            style="@style/AppTheme.Button.BlueButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/height_button_64"
            android:layout_below="@id/btn_prepare_laser_work_height_select_mode_input_material"
            android:layout_marginTop="@dimen/margin_layout_20"
            android:layout_marginStart="80dp"
            android:layout_marginEnd="80dp"
            android:text="触碰材料表面"
            android:textSize="@dimen/font_size_h3" />

        <Button
            android:id="@+id/btn_prepare_laser_work_height_select_mode_manual"
            style="@style/AppTheme.Button.BlueButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/height_button_64"
            android:layout_below="@id/btn_prepare_laser_work_height_select_mode_touch_material"
            android:layout_marginTop="@dimen/margin_layout_20"
            android:layout_marginStart="80dp"
            android:layout_marginEnd="80dp"
            android:text="手动设置"
            android:textSize="@dimen/font_size_h3" />
    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/view_prepare_laser_work_height_buttons"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_layout_40"
        android:layout_marginEnd="@dimen/margin_layout_40"
        android:layout_marginBottom="@dimen/margin_layout_20"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <Button
            android:id="@+id/btn_prepare_laser_work_height_select_mode_cancel"
            style="@style/AppTheme.Button.DefaultButton"
            android:layout_width="300dp"
            android:layout_height="@dimen/height_button_64"
            android:layout_alignParentStart="true"
            android:layout_marginStart="@dimen/margin_layout_20"
            android:text="取消"
            android:textSize="@dimen/font_size_h3" />

        <Button
            android:id="@+id/btn_prepare_laser_work_height_select_mode_confirm"
            style="@style/AppTheme.Button.BlueButton"
            android:layout_width="300dp"
            android:layout_height="@dimen/height_button_64"
            android:layout_alignParentEnd="true"
            android:layout_marginStart="@dimen/margin_layout_40"
            android:layout_marginEnd="@dimen/margin_layout_20"
            android:text="确定"
            android:textSize="@dimen/font_size_h3" />

    </RelativeLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
