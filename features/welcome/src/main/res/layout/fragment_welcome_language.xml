<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/pic_welcome_hello"
    android:clickable="true"
    android:focusable="true">


    <TextView
        android:id="@+id/tv_welcome_language_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="108dp"
        android:layout_marginStart="@dimen/margin_layout_40"
        android:layout_marginEnd="@dimen/margin_layout_40"
        android:text="@string/welcome_language_desc"
        android:textAlignment="center"
        android:textColor="@color/default_theme_desc1"
        android:textSize="@dimen/font_size_h3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <RelativeLayout
        android:id="@+id/rl_language_list"
        android:layout_width="968dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/margin_layout_40"
        app:layout_constraintBottom_toTopOf="@id/btn_welcome_set_language_next"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_welcome_language_desc">

        <Button
            android:id="@+id/btn_language_english"
            style="@style/AppTheme.Button.DefaultButton"
            android:layout_width="224dp"
            android:layout_height="92dp"
            android:layout_alignParentTop="true"
            android:layout_alignParentStart="true"
            android:text="English" />

        <Button
            android:id="@+id/btn_language_german"
            style="@style/AppTheme.Button.DefaultButton"
            android:layout_width="224dp"
            android:layout_height="92dp"
            android:layout_toEndOf="@id/btn_language_english"
            android:layout_marginStart="24dp"
            android:text="Deustch"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btn_language_simplified_chinese"
            style="@style/AppTheme.Button.DefaultButton"
            android:layout_width="224dp"
            android:layout_height="92dp"
            android:layout_alignTop="@id/btn_language_english"
            android:layout_toEndOf="@id/btn_language_german"
            android:layout_marginStart="24dp"
            android:text="简体中文" />
        　　
        <Button
            android:id="@+id/btn_language_french"
            style="@style/AppTheme.Button.DefaultButton"
            android:layout_width="224dp"
            android:layout_height="92dp"
            android:layout_alignParentEnd="true"
            android:layout_alignTop="@id/btn_language_english"
            android:layout_toEndOf="@id/btn_language_simplified_chinese"
            android:layout_marginStart="24dp"
            android:text="français" />

        <Button
            android:id="@+id/btn_language_japanese"
            style="@style/AppTheme.Button.DefaultButton"
            android:layout_width="224dp"
            android:layout_height="92dp"
            android:layout_below="@id/btn_language_english"
            android:layout_alignParentStart="true"
            android:layout_marginStart="248dp"
            android:layout_marginTop="24dp"
            android:text="日本語" />　　

        <Button
            android:id="@+id/btn_language_korean"
            style="@style/AppTheme.Button.DefaultButton"
            android:layout_width="224dp"
            android:layout_height="92dp"
            android:layout_alignTop="@id/btn_language_japanese"
            android:layout_toEndOf="@id/btn_language_japanese"
            android:layout_marginStart="24dp"
            android:text="한국어" />

        <Button
            android:id="@+id/btn_language_italian"
            style="@style/AppTheme.Button.DefaultButton"
            android:layout_width="224dp"
            android:layout_height="92dp"
            android:layout_alignTop="@id/btn_language_japanese"
            android:layout_toEndOf="@id/btn_language_korean"
            android:layout_marginStart="24dp"
            android:text="italiano" />

    </RelativeLayout>

    <Button
        android:id="@+id/btn_welcome_set_language_next"
        style="@style/AppTheme.Button.BlueButtonLarge"
        android:layout_width="292dp"
        android:layout_height="92dp"
        android:layout_marginBottom="120dp"
        android:text="@string/all_next"
        android:textSize="28sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/rl_language_list" />

</androidx.constraintlayout.widget.ConstraintLayout>
