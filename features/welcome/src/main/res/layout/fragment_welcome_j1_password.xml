<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <include
        layout="@layout/j1_toolbar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/view_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/fg_bg_round"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar" />

    <TextView
        android:id="@+id/tv_title"
        style="@style/AppTheme.TextTitleSecondary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_layout_24"
        android:text="@string/welcome_wifi_enter_password"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@id/view_container"
        app:layout_constraintStart_toStartOf="@id/view_container"
        app:layout_constraintTop_toTopOf="@id/view_container" />

    <TextView
        android:id="@+id/tv_ssid"
        style="@style/AppTheme.TextBody2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/palette_grey_storm"
        app:layout_constraintEnd_toEndOf="@id/view_container"
        app:layout_constraintStart_toStartOf="@id/view_container"
        app:layout_constraintTop_toBottomOf="@id/tv_title"
        tools:text="Snapmaker-Mock" />

    <EditText
        android:id="@+id/et_password"
        style="@style/AppTheme.TextBody2"
        android:layout_width="320dp"
        android:layout_height="52dp"
        android:layout_marginTop="@dimen/margin_layout_20"
        android:background="@drawable/shape_bg_j1_input"
        android:importantForAutofill="no"
        android:inputType="textPassword"
        android:maxLines="1"
        android:paddingStart="@dimen/margin_layout_16"
        android:paddingEnd="@dimen/margin_layout_16"
        android:textColor="@color/palette_grey_french"
        app:layout_constraintEnd_toEndOf="@id/view_container"
        app:layout_constraintStart_toStartOf="@id/view_container"
        app:layout_constraintTop_toBottomOf="@id/tv_ssid" />

    <View
        android:id="@+id/view_bottom_container"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:background="@drawable/shape_bg_section_detail_normal"
        app:layout_constraintBottom_toBottomOf="@id/view_container"
        app:layout_constraintEnd_toEndOf="@id/view_container"
        app:layout_constraintStart_toStartOf="@id/view_container" />

    <Button
        android:id="@+id/btn_connect"
        style="@style/AppTheme.PrimaryButton"
        android:layout_width="140dp"
        android:layout_height="48dp"
        android:layout_marginEnd="@dimen/margin_layout_12"
        android:text="@string/all_connect"
        android:textAllCaps="false"
        app:layout_constraintBottom_toBottomOf="@id/view_bottom_container"
        app:layout_constraintEnd_toEndOf="@id/view_bottom_container"
        app:layout_constraintTop_toTopOf="@id/view_bottom_container" />
</androidx.constraintlayout.widget.ConstraintLayout>
