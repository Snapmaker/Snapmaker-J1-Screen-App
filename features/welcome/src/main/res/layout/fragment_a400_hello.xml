<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_hello"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <TextView
            android:id="@+id/tv_welcome_hello_title"
            android:layout_width="wrap_content"
            android:layout_height="144dp"
            android:layout_marginTop="192dp"
            android:fontFamily="@string/font_roboto_condensed"
            android:text="@string/all_hello"
            android:textColor="@color/palette_white_pure"
            android:textSize="120sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_welcome_hello_subtitle"
            style="@style/AppTheme.TextBody2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_layout_5"
            android:text="@string/welcome_hello_sentence"
            android:textColor="@color/palette_white_silver"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_welcome_hello_title" />

        <RelativeLayout
            android:id="@+id/viewCheckJoin"
            android:layout_width="wrap_content"
            android:layout_height="68dp"
            android:layout_marginBottom="28dp"
            app:layout_constraintBottom_toTopOf="@id/btn_welcome_hello_start"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <CheckBox
                android:id="@+id/cb_hello"
                style="@style/AppTheme.CheckBox"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:textColor="@color/default_theme_title" />

            <TextView
                android:id="@+id/textView3"
                style="@style/AppTheme.TextBody2"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_toEndOf="@id/cb_hello"
                android:gravity="center_vertical"
                android:text="@string/a400_hello_read_and_agree"
                android:textColor="@color/palette_white_silver" />

            <TextView
                android:id="@+id/textView4"
                style="@style/AppTheme.TextBody2"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_toEndOf="@id/textView3"
                android:gravity="center_vertical"
                android:text="@string/a400_hello_terms_and_conditions"
                android:textColor="@color/palette_blue_ribbon"
                android:textSize="24sp" />

        </RelativeLayout>

        <Button
            android:id="@+id/btn_welcome_hello_start"
            style="@style/AppTheme.PrimaryButton"
            android:layout_width="236dp"
            android:layout_height="92dp"
            android:layout_marginBottom="120dp"
            android:background="@drawable/a400_select_shape_welcome_hello_btn"
            android:text="@string/welcome_hello_start"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>


    <include
        layout="@layout/weight_terms_and_conditions"
        android:visibility="gone" />

</androidx.constraintlayout.widget.ConstraintLayout>