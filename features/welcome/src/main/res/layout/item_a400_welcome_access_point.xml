<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="81dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingRight="58dp">

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/progress_scan"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/margin_layout_8"
        android:indeterminate="true"
        android:visibility="gone"
        app:indicatorColor="@color/palette_grey_french"
        app:indicatorSize="44dp"
        app:trackColor="#2D2F40"
        app:trackCornerRadius="1dp"
        app:trackThickness="4dp" />

    <ImageView
        android:id="@+id/iv_access_point_suc"
        android:layout_width="68dp"
        android:layout_height="68dp"
        android:layout_centerVertical="true"
        android:background="@drawable/ic_green_suc_126x126"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tv_access_point_ssid"
        style="@style/AppTheme.TextBody1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:layout_marginStart="75dp"
        android:layout_marginEnd="@dimen/margin_layout_10"
        android:layout_toStartOf="@id/iv_settings_ap_item_has_authentication"
        android:layout_toLeftOf="@+id/iv_access_point_signal"
        android:layout_weight="1"
        android:ellipsize="end"
        android:textColor="@color/palette_white_silver" />

    <ImageView
        android:id="@+id/iv_settings_ap_item_has_authentication"
        android:layout_width="68dp"
        android:layout_height="68dp"
        android:layout_centerVertical="true"
        android:layout_marginEnd="@dimen/margin_layout_5"
        android:layout_toLeftOf="@+id/iv_access_point_signal"
        android:contentDescription="@string/placeholder" />

    <ImageView
        android:id="@+id/iv_access_point_signal"
        android:layout_width="68dp"
        android:layout_height="68dp"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:contentDescription="@string/placeholder" />

</RelativeLayout>
