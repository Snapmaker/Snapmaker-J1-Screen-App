<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:fitsSystemWindows="true"
    android:focusable="true">

    <TextView
        android:id="@+id/tv_welcome_name_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="212dp"
        android:fontFamily="@string/font_roboto_condensed"
        android:text="@string/a400_welcome_name_title"
        android:textColor="@color/palette_white_silver"
        android:textSize="24sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <RelativeLayout
        android:id="@+id/view_welcome_name_input"
        android:layout_width="416dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_layout_32"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_welcome_name_title">

        <EditText
            android:id="@+id/et_welcome_name_input"
            android:layout_width="416dp"
            android:layout_height="84dp"
            android:background="@drawable/a400_shape_bg_terms_and_conditions_print"
            android:hint="@string/welcome_name_placeholder"
            android:inputType="text"
            android:paddingLeft="@dimen/margin_layout_24"
            android:paddingRight="@dimen/margin_layout_24"
            android:textColor="@color/palette_white_pure"
            android:textSize="@dimen/font_size_24sp" />

    </RelativeLayout>

    <Button
        android:id="@+id/btn_welcome_name_next"
        style="@style/AppTheme.PrimaryButton"
        android:layout_width="292dp"
        android:layout_height="92dp"
        android:layout_marginBottom="120dp"
        android:background="@drawable/a400_select_shape_welcome_hello_btn"
        android:text="@string/all_next"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
