    <string name="j1_guide_install_fan_instructions_intro_title">Fix Print Cooling Fan</string>
    <string name="j1_guide_install_fan_instructions_intro_content">Tap <b>Go to Install</b> to install screws to further fix the print cooling fan.
        \nIf you\’ve installed the screws or not purchased the Print Cooling Fan Upgrade Kit, tap <b>Skip</b>.</string>
    <string name="j1_guide_install_fan_instructions_intro_go_to_install">Go to Install</string>
    <string name="j1_guide_install_fan_instructions_install_screws_title">Install Screws</string>

    <string name="j1_guide_install_fan_instructions_install_screws_step1">1. Install two M3 × 10 screws to the illustrated positions with the pink H2.0 hex key.</string>
    <string name="j1_guide_install_fan_instructions_install_screws_step2">2. Tap <b>Next</b>.</string>
    <string name="j1_guide_install_fan_instructions_install_screws_note"><b>Note</b>: The motor has been temporarily turned off. </string>
    <string name="j1_guide_install_fan_instructions_prepare_for_homing_title">Prepare for Homing</string>
    <string name="j1_guide_install_fan_instructions_prepare_for_homing_content">
        1. Clear away any external things inside the machine and keep your body away.
        \n2. Tap <b>Next</b>. The machine will start homing.
    </string>

