<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/palette_black_snapmaker">

    <ImageView
        android:id="@+id/iv_start_icon"
        android:layout_width="148dp"
        android:layout_height="148dp"
        android:layout_marginTop="68dp"
        android:src="@drawable/pic_milstone_success"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_title_main"
        style="@style/AppTheme.TextTitlePrimary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:text="开始你的表演"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/iv_start_icon" />

    <TextView
        android:id="@+id/tv_main_desc"
        style="@style/AppTheme.TextBody2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="接下来你将继续完成单头双喷嘴模块的初始化"
        app:layout_constraintEnd_toEndOf="@id/tv_title_main"
        app:layout_constraintStart_toStartOf="@id/tv_title_main"
        app:layout_constraintTop_toBottomOf="@id/tv_title_main" />

    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="274dp"
        android:layout_marginTop="@dimen/margin_layout_32"
        android:background="@drawable/fg_black_round_bg"
        android:paddingTop="@dimen/margin_layout_24"
        android:paddingBottom="@dimen/margin_layout_8"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:minWidth="437dp"
        app:layout_constraintTop_toBottomOf="@id/tv_main_desc">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_procedure_list"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            tools:listitem="@layout/item_guide_procedure" />
    </RelativeLayout>

    <Button
        android:id="@+id/btn_start_or_continue"
        style="@style/AppTheme.PrimaryButton"
        android:layout_width="292dp"
        android:layout_height="92dp"
        android:layout_marginBottom="@dimen/margin_layout_48"
        android:text="@string/all_start"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
