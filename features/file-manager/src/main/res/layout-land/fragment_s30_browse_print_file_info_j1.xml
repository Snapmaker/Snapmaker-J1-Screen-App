<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:clickable="true"
    android:focusable="true">

    <include layout="@layout/widget_top_bar_back_only" />

    <RelativeLayout
        android:id="@+id/view_print_model"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="60dp"
        android:layout_marginTop="@dimen/margin_layout_20"
        app:layout_constraintTop_toBottomOf="@id/top_bar"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/iv_print_platform"
            android:layout_width="400dp"
            android:layout_height="150dp"
            android:layout_marginTop="120dp"
            android:scaleType="fitCenter"
            android:src="@drawable/demo_print_platform" />

        <ImageView
            android:id="@+id/iv_print_model"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_centerHorizontal="true"
            android:scaleType="fitCenter"
            android:src="@drawable/demo_print_model1" />

    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/view_print_file_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_layout_60"
        android:layout_marginTop="@dimen/margin_layout_10"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/top_bar">

        <TextView
            android:id="@+id/tv_print_file_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="@dimen/margin_layout_5"
            android:textAlignment="textStart"
            android:textColor="@color/default_theme_desc1"
            android:textSize="@dimen/font_size_h4" />

    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/view_print_file_buttons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_layout_40"
        android:layout_marginEnd="@dimen/margin_layout_40"
        android:layout_marginBottom="@dimen/margin_layout_20"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <Button
            android:id="@+id/btn_browse_start_print"
            style="@style/AppTheme.Button.BlueButton"
            android:layout_width="300dp"
            android:layout_height="@dimen/height_button_80"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="@dimen/margin_layout_20"
            android:text="开始打印"
            android:textSize="@dimen/font_size_h3" />
    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/view_print_file_mode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_layout_40"
        android:layout_marginBottom="@dimen/margin_layout_20"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <Spinner
            android:id="@+id/sp_print_file_mode"
            android:layout_width="240dp"
            android:layout_height="60dp"
            android:entries="@array/peripheral_print_mode" />
    </RelativeLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
