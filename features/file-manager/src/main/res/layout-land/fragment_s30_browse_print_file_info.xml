<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:clickable="true"
    android:focusable="true">

    <RelativeLayout
        android:id="@+id/view_print_model"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="60dp"
        android:layout_marginTop="@dimen/margin_layout_20"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/iv_print_platform"
            android:layout_width="400dp"
            android:layout_height="150dp"
            android:layout_marginTop="120dp"
            android:scaleType="fitCenter"
            android:src="@drawable/demo_print_platform" />

        <ImageView
            android:id="@+id/iv_print_model"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_centerHorizontal="true"
            android:scaleType="fitCenter"
            android:src="@drawable/demo_print_model1" />

        <TextView
            android:id="@+id/tv_print_file_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/iv_print_platform"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="@dimen/margin_layout_5"
            android:text="Rabbit.gcode"
            android:textColor="@color/default_theme_desc1"
            android:textSize="@dimen/font_size_h4" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tv_print_file_name"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="@dimen/margin_layout_5"
            android:text="132KB 2021.3.05 15:36"
            android:textColor="@color/default_theme_desc1"
            android:textSize="@dimen/font_size_h4" />

    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/view_print_file_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_layout_60"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/view_print_model"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tv_print_file_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="@dimen/margin_layout_5"
            android:textAlignment="textStart"
            android:textColor="@color/default_theme_desc1"
            android:textSize="@dimen/font_size_h4" />

    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/view_print_complete_buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_layout_40"
        android:layout_marginEnd="@dimen/margin_layout_40"
        android:layout_marginBottom="@dimen/margin_layout_20"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <Button
            android:id="@+id/btn_print_continue"
            style="@style/AppTheme.Button.DefaultButton"
            android:layout_width="200dp"
            android:layout_height="@dimen/height_button_80"
            android:layout_marginEnd="@dimen/margin_layout_40"
            android:textSize="@dimen/font_size_h3"
            android:layout_toStartOf="@id/btn_print_complete"
            android:text="Close" />

        <Button
            android:id="@+id/btn_print_complete"
            style="@style/AppTheme.Button.BlueButton"
            android:layout_width="200dp"
            android:layout_height="@dimen/height_button_80"
            android:layout_marginEnd="@dimen/margin_layout_20"
            android:textSize="@dimen/font_size_h3"
            android:layout_alignParentEnd="true"
            android:text="Print" />
    </RelativeLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
